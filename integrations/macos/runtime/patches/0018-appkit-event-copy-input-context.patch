diff --git a/src/external/cocotron/AppKit/NSTextInput.m b/src/external/cocotron/AppKit/NSTextInput.m
--- a/src/external/cocotron/AppKit/NSTextInput.m
+++ b/src/external/cocotron/AppKit/NSTextInput.m
@@ -1,5 +1,13 @@
 #include <AppKit/NSTextInput.h>
 #include <AppKit/NSTextInput_Internal.h>
+#import <AppKit/NSApplication.h>
+#import <AppKit/NSWindow.h>
+#import <AppKit/NSView.h>
+
+// Only the required callback used by this limited context is invoked here.
+@protocol DarlingTextInputUnmarking
+- (void) unmarkText;
+@end
 
 NSString *const NSTextInputContextKeyboardSelectionDidChangeNotification = @"NSTextInputContextKeyboardSelectionDidChangeNotification";
 
@@ -7,4 +15,45 @@
 
 @implementation NSTextInputContext
 
++ (NSTextInputContext *) currentInputContext {
+    id responder = [[NSApp keyWindow] firstResponder];
+    if (![responder respondsToSelector: @selector(inputContext)])
+        return nil;
+    return [responder inputContext];
+}
+
+- (instancetype) initWithClient: (id<NSTextInputClient>) client {
+    self = [super init];
+    if (self != nil) {
+        Protocol *protocol = NSProtocolFromString(@"NSTextInputClient");
+        if (client == nil || protocol == nil ||
+                ![(id) client conformsToProtocol: protocol]) {
+            [self release];
+            return nil;
+        }
+        _darlingClient = client;
+    }
+    return self;
+}
+
+- (id<NSTextInputClient>) client {
+    return _darlingClient;
+}
+
+- (void) discardMarkedText {
+    if ([(id) _darlingClient respondsToSelector: @selector(unmarkText)])
+        [(id<DarlingTextInputUnmarking>) _darlingClient unmarkText];
+}
+
+- (BOOL) handleEvent: (NSEvent *) event {
+    // There is no native composition engine here. Leave the event available
+    // to the existing responder/Qt path rather than claiming it was consumed.
+    (void) event;
+    return NO;
+}
+
+- (void) _darlingInvalidateClient {
+    _darlingClient = nil;
+}
+
 @end
