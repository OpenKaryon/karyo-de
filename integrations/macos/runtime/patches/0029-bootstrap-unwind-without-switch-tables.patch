Subject: Avoid unsupported relative switch tables in bootstrap libunwind

Keep dyld chained fixups and optimized builds; constrain only static unwind.

--- a/src/external/libunwind/CMakeLists.txt
+++ b/src/external/libunwind/CMakeLists.txt
@@ -53,7 +53,9 @@
 
 include(darling_static_lib)
 add_darling_static_library(unwind_static SOURCES ${LIBUNWIND_SOURCES})
-set_target_properties(unwind_static PROPERTIES COMPILE_FLAGS "-DNDEBUG=1")
+# The bootstrap loader uses chained fixups. Its pinned ld64 cannot encode
+# relative switch lookup tables emitted by recent Clang optimizers.
+set_target_properties(unwind_static PROPERTIES COMPILE_FLAGS "-DNDEBUG=1 -fno-jump-tables")
 make_fat(unwind_static)
 
 install(TARGETS unwind DESTINATION libexec/darling/usr/lib/system)
