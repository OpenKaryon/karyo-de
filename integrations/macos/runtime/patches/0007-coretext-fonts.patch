+static double numericValue(CFTypeRef value, double fallback) {
+    double result;
+    return value && CFGetTypeID(value) == CFNumberGetTypeID() &&
+        CFNumberGetValue(value, kCFNumberDoubleType, &result) && isfinite(result) ? result : fallback;
+}
+static void putNumber(CFMutableDictionaryRef attrs, CFStringRef key, double value) {
+    CFNumberRef number = CFNumberCreate(kCFAllocatorDefault, kCFNumberDoubleType, &value);
+    if (number) { CFDictionarySetValue(attrs, key, number); CFRelease(number); }
+}
+static void putUTF8(CFMutableDictionaryRef attrs, CFStringRef key, const char *value) {
+    CFStringRef string = value ? CFStringCreateWithCString(kCFAllocatorDefault, value, kCFStringEncodingUTF8) : NULL;
+    if (string) { CFDictionarySetValue(attrs, key, string); CFRelease(string); }
+}
+static CGAffineTransform descriptorMatrix(CFDictionaryRef attrs, const CGAffineTransform *override) {
+    CGAffineTransform matrix = CGAffineTransformIdentity;
+    if (override) matrix = *override;
+    else if (attrs) {
+        CFTypeRef value = CFDictionaryGetValue(attrs, kCTFontMatrixAttribute);
+        if (value && CFGetTypeID(value) == CFDataGetTypeID() && CFDataGetLength(value) == sizeof(matrix))
+            memcpy(&matrix, CFDataGetBytePtr(value), sizeof(matrix));
+    }
+    if (!isfinite(matrix.a) || !isfinite(matrix.b) || !isfinite(matrix.c) || !isfinite(matrix.d))
+        matrix = CGAffineTransformIdentity;
+    /* kCTFontMatrixAttribute only uses the four linear fields (Apple SDK 11.3). */
+    if (!override) matrix.tx = matrix.ty = 0;
+    return matrix;
+}
+static CGFloat descriptorSize(CFDictionaryRef attrs, CGFloat override) {
+    double size = override != 0 ? override : attrs ?
+        numericValue(CFDictionaryGetValue(attrs, kCTFontSizeAttribute), 12) : 12;
+    return isfinite(size) && size > 0 ? size : 12;
+}
