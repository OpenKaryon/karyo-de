+/* The font storage is an Objective-C KTFont; its _cfTypeID method uses this
+ * registered CF type. Ordinary object retain/release remains the owning path. */
+static CFTypeID fontType;
+static pthread_once_t fontOnce = PTHREAD_ONCE_INIT;
+static void registerFontType(void) {
+    static const CFRuntimeClass fontClass = { .version = 0, .className = "CTFont" };
+    fontType = _CFRuntimeRegisterClass(&fontClass);
+}
+CFTypeID CTFontGetTypeID(void) { pthread_once(&fontOnce, registerFontType); return fontType; }
