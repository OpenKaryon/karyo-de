+static CTFontDescriptorRef descriptorForGraphicsFont(O2Font_freetype *graphics, CGFloat size,
+                                                    CGAffineTransform matrix,
+                                                    CTFontDescriptorRef requested) {
+    CFDictionaryRef requestedAttrs = requested ? CTFontDescriptorCopyAttributes(requested) : NULL;
+    CFMutableDictionaryRef attrs = requestedAttrs ? CFDictionaryCreateMutableCopy(kCFAllocatorDefault, 0, requestedAttrs) :
+        CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    if (requestedAttrs) CFRelease(requestedAttrs);
+    if (!attrs) return NULL;
+    removeFaceIdentity(attrs, true);
+    CFDictionaryRemoveValue(attrs, kCTFontTraitsAttribute);
+    @synchronized(graphics) {
+        FT_Face face = [graphics face];
+        if (!face) { CFRelease(attrs); return NULL; }
+        NSString *filename = [graphics fontFilename];
+        if (filename) {
+            int count = 0;
+            FcPattern *pattern = FcFreeTypeQuery((const FcChar8 *)[filename UTF8String],
+                (unsigned int)[graphics fontFaceIndex], NULL, &count);
+            CTFontDescriptorRef actual = pattern ? _KTFontDescriptorCreateFromFontConfigPattern(pattern) : NULL;
+            CFDictionaryRef actualAttrs = actual ? CTFontDescriptorCopyAttributes(actual) : NULL;
+            if (actualAttrs) {
+                CFDictionaryApplyFunction(actualAttrs, copyActualAttribute, attrs);
+                CFRelease(actualAttrs);
+            }
+            if (actual) CFRelease(actual);
+            if (pattern) FcPatternDestroy(pattern);
+            if (!CFDictionaryContainsKey(attrs, kCTFontURLAttribute)) {
+                CFStringRef path = CFStringCreateWithFormat(kCFAllocatorDefault, NULL,
+                    CFSTR("/Volumes/SystemRoot%@"), (CFStringRef)filename);
+                CFURLRef url = path ? CFURLCreateWithFileSystemPath(kCFAllocatorDefault, path, kCFURLPOSIXPathStyle, false) : NULL;
+                if (url) { CFDictionarySetValue(attrs, kCTFontURLAttribute, url); CFRelease(url); }
+                if (path) CFRelease(path);
+                NSInteger index = [graphics fontFaceIndex];
+                CFNumberRef n = CFNumberCreate(kCFAllocatorDefault, kCFNumberLongType, &index);
+                if (n) { CFDictionarySetValue(attrs, _KTFontFaceIndexAttribute, n); CFRelease(n); }
+            }
+        }
+        /* These fields come from the face actually opened, not the requested alias. */
+        putUTF8(attrs, kCTFontNameAttribute, FT_Get_Postscript_Name(face));
+        if (!CFDictionaryContainsKey(attrs, kCTFontFamilyNameAttribute)) putUTF8(attrs, kCTFontFamilyNameAttribute, face->family_name);
+        if (!CFDictionaryContainsKey(attrs, kCTFontStyleNameAttribute)) putUTF8(attrs, kCTFontStyleNameAttribute, face->style_name);
+        CFStringRef fullName = copySFNTName(face, 4);
+        if (fullName) { CFDictionarySetValue(attrs, kCTFontDisplayNameAttribute, fullName); CFRelease(fullName); }
+        if (!CFDictionaryContainsKey(attrs, kCTFontTraitsAttribute)) {
+            CFMutableDictionaryRef traits = CFDictionaryCreateMutable(kCFAllocatorDefault, 0,
+                &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+            if (traits) {
+                uint32_t bits = 0;
+                if (face->style_flags & FT_STYLE_FLAG_BOLD) bits |= kCTFontTraitBold;
+                if (face->style_flags & FT_STYLE_FLAG_ITALIC) bits |= kCTFontTraitItalic;
+                if (FT_IS_FIXED_WIDTH(face)) bits |= kCTFontTraitMonoSpace;
+                TT_OS2 *os2 = FT_Get_Sfnt_Table(face, ft_sfnt_os2);
+                double width = os2 && os2->usWidthClass ? ((int)os2->usWidthClass - 5) / 4.0 : 0;
+                if (width > 0) bits |= kCTFontTraitExpanded;
+                if (width < 0) bits |= kCTFontTraitCondensed;
+                double weight = face->style_flags & FT_STYLE_FLAG_BOLD ? .4 : 0;
+                if (os2 && os2->usWeightClass) {
+                    unsigned w = os2->usWeightClass;
+                    weight = w <= 100 ? -.8 : w <= 200 ? -.6 : w <= 300 ? -.4 : w <= 400 ? 0 :
+                        w <= 500 ? .23 : w <= 600 ? .3 : w <= 700 ? .4 : w <= 800 ? .56 : .62;
+                }
+                CFNumberRef symbolic = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt32Type, &bits);
+                if (symbolic) { CFDictionarySetValue(traits, kCTFontSymbolicTrait, symbolic); CFRelease(symbolic); }
+                putNumber(traits, kCTFontWeightTrait, weight); putNumber(traits, kCTFontWidthTrait, width);
+                putNumber(traits, kCTFontSlantTrait, face->style_flags & FT_STYLE_FLAG_ITALIC ? .2 : 0);
+                CFDictionaryRef immutable = CFDictionaryCreateCopy(kCFAllocatorDefault, traits);
+                if (immutable) { CFDictionarySetValue(attrs, kCTFontTraitsAttribute, immutable); CFRelease(immutable); }
+                CFRelease(traits);
+            }
+        }
+        if (!CFDictionaryContainsKey(attrs, kCTFontCharacterSetAttribute)) {
+            CFCharacterSetRef charset = copyFaceCharacterSet(face);
+            if (charset) { CFDictionarySetValue(attrs, kCTFontCharacterSetAttribute, charset); CFRelease(charset); }
+        }
+        /* A memory-provider face has no fictitious filename or registration claim.
+         * Retain the actual graphics object to support normalized in-process round trips. */
+        if (!filename) CFDictionarySetValue(attrs, graphicsFontAttribute, graphics);
+    }
+    putNumber(attrs, kCTFontSizeAttribute, size);
+    CFDataRef matrixData = CFDataCreate(kCFAllocatorDefault, (const UInt8 *)&matrix, sizeof(matrix));
+    if (matrixData) { CFDictionarySetValue(attrs, kCTFontMatrixAttribute, matrixData); CFRelease(matrixData); }
+    CTFontDescriptorRef result = _KTFontDescriptorCreateWithAttributes(attrs, true);
+    CFRelease(attrs);
+    return result;
+}
+static Boolean installDescriptor(CTFontRef font, CTFontDescriptorRef requested) {
+    if (!font) return false;
+    CTFontDescriptorRef descriptor = descriptorForGraphicsFont(graphicsFont(font), [(KTFont *)font pointSize],
+        [(KTFont *)font fontMatrix], requested);
+    if (!descriptor) return false;
+    [(KTFont *)font setFontDescriptor:descriptor]; CFRelease(descriptor);
+    return true;
+}
+static CTFontRef createWithGraphics(CGFontRef graphics, CGFloat size, const CGAffineTransform *matrix,
+                                    CTFontDescriptorRef requested) {
+    CTFontRef font = (CTFontRef)[[KTFont alloc] initWithFont:graphics size:size matrix:matrix descriptor:NULL];
+    if (font && !installDescriptor(font, requested)) { [(KTFont *)font release]; return NULL; }
+    return font;
+}
+static O2Font_freetype *openDescriptorFile(CFDictionaryRef attrs) {
+    CFTypeRef url = attrs ? CFDictionaryGetValue(attrs, kCTFontURLAttribute) : NULL;
+    if (!url || CFGetTypeID(url) != CFURLGetTypeID()) return nil;
+    CFStringRef scheme = CFURLCopyScheme(url);
+    Boolean file = scheme && CFEqual(scheme, CFSTR("file"));
+    if (scheme) CFRelease(scheme);
+    if (!file) return nil;
+    CFStringRef path = CFURLCopyFileSystemPath(url, kCFURLPOSIXPathStyle);
+    NSString *filename = (NSString *)path;
+    NSString *prefix = @"/Volumes/SystemRoot";
+    if ([filename hasPrefix:@"/Volumes/SystemRoot/"]) filename = [filename substringFromIndex:[prefix length]];
+    NSInteger index = (NSInteger)numericValue(CFDictionaryGetValue(attrs, _KTFontFaceIndexAttribute), 0);
+    O2Font_freetype *graphics = path ? [[O2Font_freetype alloc] initWithFontFilename:filename faceIndex:index] : nil;
+    if (path) CFRelease(path);
+    return graphics;
+}
+
+CTFontRef CTFontCreateWithName(CFStringRef name, CGFloat size, const CGAffineTransform *matrix) {
+    CTFontDescriptorRef descriptor = CTFontDescriptorCreateWithNameAndSize(name, size);
+    CTFontRef font = descriptor ? CTFontCreateWithFontDescriptor(descriptor, size, matrix) : NULL;
+    if (descriptor) CFRelease(descriptor);
+    return font;
+}
+CTFontRef CTFontCreateWithNameAndOptions(CFStringRef name, CGFloat size, const CGAffineTransform *matrix, CTFontOptions options) {
+    /* This backend only uses installed/local fonts; it has no activation or download side effects. */
+    (void)options; return CTFontCreateWithName(name, size, matrix);
+}
+CTFontRef CTFontCreateWithFontDescriptor(CTFontDescriptorRef descriptor, CGFloat size, const CGAffineTransform *matrix) {
+    CFDictionaryRef attrs = descriptor ? CTFontDescriptorCopyAttributes(descriptor) : NULL;
+    if (!attrs) return NULL;
+    CGFloat pointSize = descriptorSize(attrs, size);
+    CGAffineTransform transform = descriptorMatrix(attrs, matrix);
+    CFTypeRef embedded = CFDictionaryGetValue(attrs, graphicsFontAttribute);
+    O2Font_freetype *graphics = embedded && [(id)embedded isKindOfClass:[O2Font_freetype class]] ?
+        [(O2Font_freetype *)embedded retain] : openDescriptorFile(attrs);
+    CTFontDescriptorRef matched = NULL;
+    if (!graphics) {
+        matched = CTFontDescriptorCreateMatchingFontDescriptor(descriptor, NULL);
+        CFDictionaryRef matchAttrs = matched ? CTFontDescriptorCopyAttributes(matched) : NULL;
+        if (matchAttrs) { graphics = openDescriptorFile(matchAttrs); CFRelease(matchAttrs); }
+    }
+    CTFontRef font = graphics ? createWithGraphics((CGFontRef)graphics, pointSize, &transform, descriptor) : NULL;
+    [graphics release];
+    if (matched) CFRelease(matched);
+    CFRelease(attrs);
+    return font;
+}
