+static O2Font_freetype *graphicsFont(CTFontRef font) {
+    return font ? (O2Font_freetype *)[(KTFont *)font graphicsFont] : nil;
+}
+static const CFStringRef graphicsFontAttribute = CFSTR("OpenKaryonGraphicsFont");
