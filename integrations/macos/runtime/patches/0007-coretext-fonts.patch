+            free(utf8);
+        }
+        if (path) CFRelease(path);
+    }
+    CFTypeRef indexValue = CFDictionaryGetValue(attributes, _KTFontFaceIndexAttribute);
+    if (indexValue) FcPatternAddInteger(pattern, FC_INDEX, (int)numberValue(indexValue, 0));
+    double size = numberValue(CFDictionaryGetValue(attributes, kCTFontSizeAttribute), 0);
+    if (size > 0) FcPatternAddDouble(pattern, FC_SIZE, size);
+    CFTypeRef traits = CFDictionaryGetValue(attributes, kCTFontTraitsAttribute);
+    if (traits && CFGetTypeID(traits) == CFDictionaryGetTypeID()) {
+        uint32_t symbolic = (uint32_t)numberValue(CFDictionaryGetValue(traits, kCTFontSymbolicTrait), 0);
+        CFTypeRef weight = CFDictionaryGetValue(traits, kCTFontWeightTrait);
+        if (weight || (symbolic & kCTFontTraitBold))
+            FcPatternAddInteger(pattern, FC_WEIGHT, fontConfigWeight(numberValue(weight,
+                symbolic & kCTFontTraitBold ? 0.4 : 0)));
+        CFTypeRef slant = CFDictionaryGetValue(traits, kCTFontSlantTrait);
+        if (slant || (symbolic & kCTFontTraitItalic))
+            FcPatternAddInteger(pattern, FC_SLANT,
+                numberValue(slant, symbolic & kCTFontTraitItalic ? 0.2 : 0) != 0 ? FC_SLANT_ITALIC : FC_SLANT_ROMAN);
+        CFTypeRef width = CFDictionaryGetValue(traits, kCTFontWidthTrait);
+        if (width || (symbolic & (kCTFontTraitExpanded | kCTFontTraitCondensed)))
+            FcPatternAddInteger(pattern, FC_WIDTH, (int)(FC_WIDTH_NORMAL *
+                (1 + numberValue(width, symbolic & kCTFontTraitExpanded ? 0.25 :
+                    symbolic & kCTFontTraitCondensed ? -0.25 : 0))));
+        if (symbolic & kCTFontTraitMonoSpace) FcPatternAddInteger(pattern, FC_SPACING, FC_MONO);
+    }
+    return pattern;
+}
+
+static void setNumber(CFMutableDictionaryRef attributes, CFStringRef key, double value) {
+    CFNumberRef number = CFNumberCreate(kCFAllocatorDefault, kCFNumberDoubleType, &value);
+    if (number) { CFDictionarySetValue(attributes, key, number); CFRelease(number); }
+}
+
+static void setString(CFMutableDictionaryRef attributes, CFStringRef key, FcPattern *pattern, const char *field) {
+    FcChar8 *string = NULL;
+    if (FcPatternGetString(pattern, field, 0, &string) != FcResultMatch || !string) return;
+    CFStringRef value = CFStringCreateWithCString(kCFAllocatorDefault, (const char *)string, kCFStringEncodingUTF8);
+    if (value) { CFDictionarySetValue(attributes, key, value); CFRelease(value); }
+}
+
+CTFontDescriptorRef _KTFontDescriptorCreateFromFontConfigPattern(FcPattern *pattern) {
+    FcChar8 *filename = NULL;
+    if (!pattern || FcPatternGetString(pattern, FC_FILE, 0, &filename) != FcResultMatch || !filename) return NULL;
+    CFMutableDictionaryRef attributes = CFDictionaryCreateMutable(kCFAllocatorDefault, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    if (!attributes) return NULL;
+    setString(attributes, kCTFontNameAttribute, pattern, FC_POSTSCRIPT_NAME);
+    setString(attributes, kCTFontFamilyNameAttribute, pattern, FC_FAMILY);
+    setString(attributes, kCTFontDisplayNameAttribute, pattern, FC_FULLNAME);
+    setString(attributes, kCTFontStyleNameAttribute, pattern, FC_STYLE);
+    CFStringRef nativePath = CFStringCreateWithCString(kCFAllocatorDefault, (const char *)filename, kCFStringEncodingUTF8);
+    CFStringRef path = nativePath ? CFStringCreateWithFormat(kCFAllocatorDefault, NULL,
+        CFSTR("/Volumes/SystemRoot%@"), nativePath) : NULL;
+    CFURLRef url = path ? CFURLCreateWithFileSystemPath(kCFAllocatorDefault, path, kCFURLPOSIXPathStyle, false) : NULL;
+    if (url) { CFDictionarySetValue(attributes, kCTFontURLAttribute, url); CFRelease(url); }
+    if (path) CFRelease(path);
+    if (nativePath) CFRelease(nativePath);
+    int index = 0;
+    FcPatternGetInteger(pattern, FC_INDEX, 0, &index);
+    CFNumberRef indexNumber = CFNumberCreate(kCFAllocatorDefault, kCFNumberIntType, &index);
+    if (indexNumber) { CFDictionarySetValue(attributes, _KTFontFaceIndexAttribute, indexNumber); CFRelease(indexNumber); }
+    /* The actual file/face provides the PostScript name if the FontConfig cache lacks it. */
+    if (!CFDictionaryContainsKey(attributes, kCTFontNameAttribute)) {
+        FT_Face face = NULL;
+        @synchronized([O2Font_freetype class]) {
+            if (FT_New_Face(O2FontSharedFreeTypeLibrary(), (const char *)filename, index, &face) == 0) {
+                const char *postScriptName = FT_Get_Postscript_Name(face);
+                CFStringRef name = postScriptName ? CFStringCreateWithCString(kCFAllocatorDefault,
+                    postScriptName, kCFStringEncodingUTF8) : NULL;
+                if (name) { CFDictionarySetValue(attributes, kCTFontNameAttribute, name); CFRelease(name); }
+                FT_Done_Face(face);
+            }
+        }
+    }
+    int weight = FC_WEIGHT_REGULAR, width = FC_WIDTH_NORMAL, slant = FC_SLANT_ROMAN, spacing = FC_PROPORTIONAL;
+    FcPatternGetInteger(pattern, FC_WEIGHT, 0, &weight); FcPatternGetInteger(pattern, FC_WIDTH, 0, &width);
+    FcPatternGetInteger(pattern, FC_SLANT, 0, &slant); FcPatternGetInteger(pattern, FC_SPACING, 0, &spacing);
+    uint32_t symbolic = 0;
+    if (weight >= FC_WEIGHT_DEMIBOLD) symbolic |= kCTFontTraitBold;
+    if (slant != FC_SLANT_ROMAN) symbolic |= kCTFontTraitItalic;
+    if (width > FC_WIDTH_NORMAL) symbolic |= kCTFontTraitExpanded;
+    if (width < FC_WIDTH_NORMAL) symbolic |= kCTFontTraitCondensed;
+    if (spacing == FC_MONO || spacing == FC_CHARCELL) symbolic |= kCTFontTraitMonoSpace;
+    CFMutableDictionaryRef traits = CFDictionaryCreateMutable(kCFAllocatorDefault, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    if (traits) {
+        CFNumberRef bits = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt32Type, &symbolic);
+        if (bits) { CFDictionarySetValue(traits, kCTFontSymbolicTrait, bits); CFRelease(bits); }
+        setNumber(traits, kCTFontWeightTrait, coreTextWeight(weight));
+        setNumber(traits, kCTFontWidthTrait, (double)(width - FC_WIDTH_NORMAL) / FC_WIDTH_NORMAL);
+        setNumber(traits, kCTFontSlantTrait, slant == FC_SLANT_ROMAN ? 0 : 0.2);
+        CFDictionaryRef immutable = CFDictionaryCreateCopy(kCFAllocatorDefault, traits);
+        if (immutable) { CFDictionarySetValue(attributes, kCTFontTraitsAttribute, immutable); CFRelease(immutable); }
+        CFRelease(traits);
+    }
+    FcCharSet *charset = NULL;
+    if (FcPatternGetCharSet(pattern, FC_CHARSET, 0, &charset) == FcResultMatch && charset) {
+        CFMutableCharacterSetRef characters = CFCharacterSetCreateMutable(kCFAllocatorDefault);
+        if (characters) {
+            FcChar32 map[FC_CHARSET_MAP_SIZE], next;
+            for (FcChar32 base = FcCharSetFirstPage(charset, map, &next); base != FC_CHARSET_DONE;
+                 base = FcCharSetNextPage(charset, map, &next)) {
+                for (unsigned word = 0; word < FC_CHARSET_MAP_SIZE; word++) {
+                    FcChar32 bits = map[word];
+                    while (bits) {
+                        unsigned bit = __builtin_ctz(bits);
+                        FcChar32 character = base + word * 32 + bit;
+                        if (character <= 0x10ffff)
+                            CFCharacterSetAddCharactersInRange(characters, CFRangeMake(character, 1));
+                        bits &= bits - 1;
+                    }
+                }
+            }
+            CFCharacterSetRef immutable = CFCharacterSetCreateCopy(kCFAllocatorDefault, characters);
+            if (immutable) { CFDictionarySetValue(attributes, kCTFontCharacterSetAttribute, immutable); CFRelease(immutable); }
+            CFRelease(characters);
+        }
+    }
+    FcLangSet *languageSet = NULL;
+    if (FcPatternGetLangSet(pattern, FC_LANG, 0, &languageSet) == FcResultMatch && languageSet) {
+        FcStrSet *strings = FcLangSetGetLangs(languageSet);
+        FcStrList *list = strings ? FcStrListCreate(strings) : NULL;
+        CFMutableArrayRef languages = CFArrayCreateMutable(kCFAllocatorDefault, 0, &kCFTypeArrayCallBacks);
+        if (list && languages) {
+            FcChar8 *language;
+            while ((language = FcStrListNext(list))) {
+                CFStringRef value = CFStringCreateWithCString(kCFAllocatorDefault, (const char *)language, kCFStringEncodingUTF8);
+                if (value) { CFArrayAppendValue(languages, value); CFRelease(value); }
+            }
+            CFArrayRef immutable = CFArrayCreateCopy(kCFAllocatorDefault, languages);
+            if (immutable) { CFDictionarySetValue(attributes, kCTFontLanguagesAttribute, immutable); CFRelease(immutable); }
+        }
+        if (languages) CFRelease(languages);
+        if (list) FcStrListDone(list);
+        if (strings) FcStrSetDestroy(strings);
+    }
+    CFDictionarySetValue(attributes, kCTFontEnabledAttribute, kCFBooleanTrue);
+    FcChar8 *format = NULL;
+    int formatValue = 0;
+    if (FcPatternGetString(pattern, FC_FONTFORMAT, 0, &format) == FcResultMatch && format) {
+        if (strcmp((const char *)format, "TrueType") == 0) formatValue = 3;
+        else if (strcmp((const char *)format, "CFF") == 0) formatValue = 1;
+        else if (strcmp((const char *)format, "Type 1") == 0) formatValue = 4;
+        else if (strcmp((const char *)format, "PCF") == 0 || strcmp((const char *)format, "BDF") == 0) formatValue = 5;
+    }
+    CFNumberRef formatNumber = CFNumberCreate(kCFAllocatorDefault, kCFNumberIntType, &formatValue);
+    if (formatNumber) { CFDictionarySetValue(attributes, kCTFontFormatAttribute, formatNumber); CFRelease(formatNumber); }
+    CTFontDescriptorRef result = _KTFontDescriptorCreateWithAttributes(attributes, true);
+    CFRelease(attributes);
+    return result;
+}
+
+static FcObjectSet *fontObjects(void) {
+    return FcObjectSetBuild(FC_FILE, FC_INDEX, FC_POSTSCRIPT_NAME, FC_FAMILY, FC_FULLNAME, FC_STYLE,
+        FC_WEIGHT, FC_WIDTH, FC_SLANT, FC_SPACING, FC_CHARSET, FC_LANG, FC_FONTFORMAT, NULL);
+}
+
+CFArrayRef _KTFontDescriptorCreateAvailableFontDescriptors(void) {
+    FcConfig *config = O2FontSharedFontConfig();
+    FcPattern *query = FcPatternCreate(); FcObjectSet *objects = fontObjects();
+    FcFontSet *fonts = config && query && objects ? FcFontList(config, query, objects) : NULL;
+    CFMutableArrayRef result = CFArrayCreateMutable(kCFAllocatorDefault, 0, &kCFTypeArrayCallBacks);
+    if (result && fonts) for (int i = 0; i < fonts->nfont; i++) {
+        CTFontDescriptorRef descriptor = _KTFontDescriptorCreateFromFontConfigPattern(fonts->fonts[i]);
+        if (descriptor) { CFArrayAppendValue(result, descriptor); CFRelease(descriptor); }
+    }
+    if (fonts) FcFontSetDestroy(fonts);
+    if (objects) FcObjectSetDestroy(objects);
+    if (query) FcPatternDestroy(query);
+    CFArrayRef immutable = result ? CFArrayCreateCopy(kCFAllocatorDefault, result) : NULL;
+    if (result) CFRelease(result);
+    return immutable;
+}
+
+static Boolean matchesMandatory(CTFontDescriptorRef query, CTFontDescriptorRef actual,
+                                CFDictionaryRef merged, CFSetRef mandatory) {
+    if (!mandatory) return true;
+    CFIndex count = CFSetGetCount(mandatory);
+    const void **keys = malloc(count * sizeof(void *));
+    if (count && !keys) return false;
+    CFSetGetValues(mandatory, keys);
+    Boolean result = true;
+    for (CFIndex i = 0; i < count; i++) {
+        CFTypeRef expected = CFDictionaryGetValue(query->attributes, keys[i]);
+        /* Identity constraints must match the resolved face. Instance/custom attrs are
+           preserved on that face before checking their exact mandatory values. */
+        CFDictionaryRef foundAttributes = selectionAttribute(keys[i]) ? actual->attributes : merged;
+        CFTypeRef found = CFDictionaryGetValue(foundAttributes, keys[i]);
+        if (expected && (!found || !CFEqual(expected, found))) { result = false; break; }
+    }
+    free(keys);
+    return result;
+}
+
+static void preserveQueryAttribute(const void *key, const void *value, void *context) {
+    CFMutableDictionaryRef result = context;
+    /* Resolved identity and coverage are supplied by the actual font; custom attrs remain retained. */
+    if (!CFDictionaryContainsKey(result, key) || CFEqual(key, kCTFontSizeAttribute) ||
+        CFEqual(key, kCTFontMatrixAttribute) || CFEqual(key, kCTFontVariationAttribute) ||
+        CFEqual(key, kCTFontFeatureSettingsAttribute) || CFEqual(key, kCTFontCascadeListAttribute))
+        CFDictionarySetValue(result, key, value);
+}
+
+static CTFontDescriptorRef normalizePatternForQuery(FcPattern *pattern, CTFontDescriptorRef query,
+                                                   CFSetRef mandatory) {
+    CTFontDescriptorRef actual = _KTFontDescriptorCreateFromFontConfigPattern(pattern);
+    if (!actual) return NULL;
+    CFMutableDictionaryRef merged = CFDictionaryCreateMutableCopy(kCFAllocatorDefault, 0, actual->attributes);
+    if (!merged) { CFRelease(actual); return NULL; }
+    CFDictionaryApplyFunction(query->attributes, preserveQueryAttribute, merged);
+    if (!matchesMandatory(query, actual, merged, mandatory)) {
+        CFRelease(merged); CFRelease(actual); return NULL;
+    }
+    CTFontDescriptorRef result = _KTFontDescriptorCreateWithAttributes(merged, true);
+    CFRelease(merged); CFRelease(actual);
+    return result;
+}
+
+CFArrayRef CTFontDescriptorCreateMatchingFontDescriptors(CTFontDescriptorRef descriptor, CFSetRef mandatoryAttributes) {
+    if (!isDescriptor(descriptor) || (mandatoryAttributes && CFGetTypeID(mandatoryAttributes) != CFSetGetTypeID())) return NULL;
+    if (descriptor->normalized) {
+        const void *value = descriptor;
+        return CFArrayCreate(kCFAllocatorDefault, &value, 1, &kCFTypeArrayCallBacks);
+    }
+    FcConfig *config = O2FontSharedFontConfig();
+    FcPattern *query = _KTFontDescriptorCreateFontConfigPattern(descriptor);
+    FcObjectSet *objects = fontObjects();
+    /* A scalable installed face supports arbitrary sizes; FC_SIZE is a match preference, not a listing filter. */
+    if (query) FcPatternDel(query, FC_SIZE);
+    FcFontSet *fonts = config && query && objects ? FcFontList(config, query, objects) : NULL;
+    CFMutableArrayRef result = CFArrayCreateMutable(kCFAllocatorDefault, 0, &kCFTypeArrayCallBacks);
+    if (result && fonts) for (int i = 0; i < fonts->nfont; i++) {
+        CTFontDescriptorRef match = normalizePatternForQuery(fonts->fonts[i], descriptor, mandatoryAttributes);
+        if (match) { CFArrayAppendValue(result, match); CFRelease(match); }
+    }
+    /* Resolve family aliases/defaults through the same backend as actual font creation. */
+    if (result && CFArrayGetCount(result) == 0 && config && query &&
+        (!mandatoryAttributes || CFSetGetCount(mandatoryAttributes) == 0)) {
+        FcConfigSubstitute(config, query, FcMatchPattern); FcDefaultSubstitute(query);
+        FcResult status; FcPattern *best = FcFontMatch(config, query, &status);
+        if (best) {
+            CTFontDescriptorRef match = normalizePatternForQuery(best, descriptor, NULL);
+            if (match) { CFArrayAppendValue(result, match); CFRelease(match); }
+            FcPatternDestroy(best);
+        }
+    }
+    if (fonts) FcFontSetDestroy(fonts);
+    if (objects) FcObjectSetDestroy(objects);
+    if (query) FcPatternDestroy(query);
+    CFArrayRef immutable = result && CFArrayGetCount(result) ? CFArrayCreateCopy(kCFAllocatorDefault, result) : NULL;
+    if (result) CFRelease(result);
+    return immutable;
+}
+
+CTFontDescriptorRef CTFontDescriptorCreateMatchingFontDescriptor(CTFontDescriptorRef descriptor,
+                                                               CFSetRef mandatoryAttributes) {
+    if (!isDescriptor(descriptor) || (mandatoryAttributes && CFGetTypeID(mandatoryAttributes) != CFSetGetTypeID())) return NULL;
+    if (descriptor->normalized) return (CTFontDescriptorRef)CFRetain(descriptor);
+    FcConfig *config = O2FontSharedFontConfig();
+    FcPattern *query = _KTFontDescriptorCreateFontConfigPattern(descriptor);
+    if (!config || !query) { if (query) FcPatternDestroy(query); return NULL; }
+    FcConfigSubstitute(config, query, FcMatchPattern); FcDefaultSubstitute(query);
+    FcResult status; FcPattern *best = FcFontMatch(config, query, &status);
+    CTFontDescriptorRef result = best ? normalizePatternForQuery(best, descriptor, mandatoryAttributes) : NULL;
+    if (best) FcPatternDestroy(best);
+    FcPatternDestroy(query);
+    /* A lower-ranked face can still satisfy an explicit mandatory constraint. */
+    if (!result && mandatoryAttributes) {
+        CFArrayRef matches = CTFontDescriptorCreateMatchingFontDescriptors(descriptor, mandatoryAttributes);
+        if (matches) {
+            if (CFArrayGetCount(matches)) result = (CTFontDescriptorRef)CFRetain(CFArrayGetValueAtIndex(matches, 0));
+            CFRelease(matches);
+        }
+    }
+    return result;
+}
