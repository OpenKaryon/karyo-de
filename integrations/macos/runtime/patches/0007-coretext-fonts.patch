+static CFStringRef copySFNTName(FT_Face face, FT_UShort nameID) {
+    CFStringRef first = NULL;
+    for (FT_UInt i = 0, count = FT_Get_Sfnt_Name_Count(face); i < count; i++) {
+        FT_SfntName entry;
+        if (FT_Get_Sfnt_Name(face, i, &entry) || entry.name_id != nameID || !entry.string_len) continue;
+        CFStringEncoding encoding;
+        if (entry.platform_id == TT_PLATFORM_APPLE_UNICODE || entry.platform_id == TT_PLATFORM_MICROSOFT)
+            encoding = kCFStringEncodingUTF16BE;
+        else if (entry.platform_id == TT_PLATFORM_MACINTOSH && entry.encoding_id == TT_MAC_ID_ROMAN)
+            encoding = kCFStringEncodingMacRoman;
+        else continue;
+        CFStringRef value = CFStringCreateWithBytes(kCFAllocatorDefault, entry.string,
+            entry.string_len, encoding, false);
+        if (!value) continue;
+        Boolean english = (entry.platform_id == TT_PLATFORM_MICROSOFT && entry.language_id == 0x409) ||
+            (entry.platform_id == TT_PLATFORM_MACINTOSH && entry.language_id == 0);
+        if (english) { if (first) CFRelease(first); return value; }
+        if (!first) first = value; else CFRelease(value);
+    }
+    return first;
+}
+static CFCharacterSetRef copyFaceCharacterSet(FT_Face face) {
+    CFMutableCharacterSetRef characters = CFCharacterSetCreateMutable(kCFAllocatorDefault);
+    if (!characters) return NULL;
+    FT_UInt glyph;
+    for (FT_ULong character = FT_Get_First_Char(face, &glyph); glyph;
+         character = FT_Get_Next_Char(face, character, &glyph))
+        if (character <= 0x10ffff) CFCharacterSetAddCharactersInRange(characters, CFRangeMake(character, 1));
+    CFCharacterSetRef result = CFCharacterSetCreateCopy(kCFAllocatorDefault, characters);
+    CFRelease(characters);
+    return result;
+}
+static void copyActualAttribute(const void *key, const void *value, void *context) {
+    CFDictionarySetValue(context, key, value);
+}
+static void removeFaceIdentity(CFMutableDictionaryRef attrs, Boolean removeFamily) {
+    const CFStringRef keys[] = { kCTFontNameAttribute, kCTFontDisplayNameAttribute, kCTFontStyleNameAttribute,
+        kCTFontURLAttribute, _KTFontFaceIndexAttribute, kCTFontCharacterSetAttribute, kCTFontLanguagesAttribute,
+        kCTFontFormatAttribute, kCTFontEnabledAttribute };
+    for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) CFDictionaryRemoveValue(attrs, keys[i]);
+    CFDictionaryRemoveValue(attrs, graphicsFontAttribute);
+    if (removeFamily) CFDictionaryRemoveValue(attrs, kCTFontFamilyNameAttribute);
+}
