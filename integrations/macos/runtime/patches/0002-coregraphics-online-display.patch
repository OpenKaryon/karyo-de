+boolean_t CGDisplayIsOnline(CGDirectDisplayID displayIndex) {
+    NSDisplay *display = currentDisplay();
+    if (!display || displayIndex == kCGNullDirectDisplay)
+        return FALSE;
+
+    // CGGetOnlineDisplayList assigns IDs i + 1 to this same backend screen list.
+    NSArray<NSScreen *> *screens = [display screens];
+    return displayIndex <= [screens count];
 }
 
