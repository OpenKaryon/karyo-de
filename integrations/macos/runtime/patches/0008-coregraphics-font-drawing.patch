--- a/src/external/cocotron/CoreGraphics/CGAffineTransform.m
+++ b/src/external/cocotron/CoreGraphics/CGAffineTransform.m
@@ -100,6 +100,23 @@
 }
 
 CGRect CGRectApplyAffineTransform(CGRect rect, CGAffineTransform t) {
-    printf("CGRectApplyAffineTransform STUB\n");
-    return rect;
+    if (CGRectIsNull(rect))
+        return CGRectNull;
+    if (CGRectIsInfinite(rect))
+        return CGRectInfinite;
+    /* A rotated/sheared rectangle needs all four corners, not just its size. */
+    CGPoint points[4] = {
+        rect.origin,
+        {rect.origin.x + rect.size.width, rect.origin.y},
+        {rect.origin.x, rect.origin.y + rect.size.height},
+        {rect.origin.x + rect.size.width, rect.origin.y + rect.size.height}
+    };
+    CGPoint point = CGPointApplyAffineTransform(points[0], t);
+    CGFloat minX = point.x, maxX = point.x, minY = point.y, maxY = point.y;
+    for (unsigned index = 1; index < 4; index++) {
+        point = CGPointApplyAffineTransform(points[index], t);
+        minX = fmin(minX, point.x); maxX = fmax(maxX, point.x);
+        minY = fmin(minY, point.y); maxY = fmax(maxY, point.y);
+    }
+    return CGRectMake(minX, minY, maxX - minX, maxY - minY);
 }
