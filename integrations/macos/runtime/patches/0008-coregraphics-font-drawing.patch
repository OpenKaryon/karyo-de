diff --git a/src/external/cocotron/CoreGraphics/CGContext.m b/src/external/cocotron/CoreGraphics/CGContext.m
--- a/src/external/cocotron/CoreGraphics/CGContext.m
+++ b/src/external/cocotron/CoreGraphics/CGContext.m
@@ -614,8 +614,26 @@
 }
 
 void CGContextShowGlyphsAtPositions(CGContextRef c,
-                                    const CGGlyph * glyphs, const CGPoint * Lpositions,
+                                    const CGGlyph *glyphs, const CGPoint *positions,
                                     size_t count)
 {
-    printf("STUB %s\n", __PRETTY_FUNCTION__);
-}
+    if (c == NULL || glyphs == NULL || positions == NULL || count == 0)
+        return;
+
+    O2ContextRef context = (O2ContextRef)c;
+    O2AffineTransform textMatrix = O2ContextGetTextMatrix(context);
+
+    /* Explicit positions are relative to the original text matrix. Dispatch
+       one glyph at a time because the existing backend accepts advances,
+       rather than absolute positions. Do not let backend advances accumulate
+       into the next explicit position or the caller's text position. */
+    for (size_t i = 0; i < count; i++) {
+        O2Point point = O2PointApplyAffineTransform(positions[i], textMatrix);
+        if (!isfinite(point.x) || !isfinite(point.y))
+            continue;
+        O2ContextSetTextPosition(context, point.x, point.y);
+        O2ContextShowGlyphs(context, glyphs + i, 1);
+    }
+
+    O2ContextSetTextMatrix(context, textMatrix);
+}
