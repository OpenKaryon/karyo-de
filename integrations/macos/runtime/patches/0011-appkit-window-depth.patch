+
+// X11Window creates an eight-bit-component, interleaved BGRA O2Surface.
+// Its RGB window depth excludes the alpha channel used for compositing.
+static const NSWindowDepth availableWindowDepths[] = {
+    NSWindowDepthTwentyfourBitRGB, 0
+};
+
+const NSWindowDepth *NSAvailableWindowDepths(void) {
+    return availableWindowDepths;
+}
+
+NSString *NSColorSpaceFromDepth(NSWindowDepth depth) {
+    switch (depth) {
+    case NSWindowDepthTwentyfourBitRGB:
+    case NSWindowDepthSixtyfourBitRGB:
+    case NSWindowDepthOnehundredtwentyeightBitRGB:
+        return NSDeviceRGBColorSpace;
+    }
+    return nil;
+}
+
+NSInteger NSBitsPerSampleFromDepth(NSWindowDepth depth) {
+    switch (depth) {
+    case NSWindowDepthTwentyfourBitRGB:
+        return 8;
+    case NSWindowDepthSixtyfourBitRGB:
+        return 16;
+    case NSWindowDepthOnehundredtwentyeightBitRGB:
+        return 32;
+    }
+    return 0;
+}
+
+NSInteger NSBitsPerPixelFromDepth(NSWindowDepth depth) {
+    switch (depth) {
+    case NSWindowDepthTwentyfourBitRGB:
+        return 24;
+    case NSWindowDepthSixtyfourBitRGB:
+        return 64;
+    case NSWindowDepthOnehundredtwentyeightBitRGB:
+        return 128;
+    }
+    return 0;
+}
+
+BOOL NSPlanarFromDepth(NSWindowDepth depth) {
+    // The RGB depths declared by AppKit describe interleaved samples.
+    return NO;
+}
+
+NSWindowDepth NSBestDepth(NSString *colorSpaceName, NSInteger bitsPerSample,
+                         NSInteger bitsPerPixel, BOOL planar, BOOL *exactMatch) {
+    BOOL colorMatches = colorSpaceName == nil ||
+            [colorSpaceName isEqualToString: NSDeviceRGBColorSpace];
+    if (exactMatch != NULL) {
+        *exactMatch = colorMatches &&
+                (bitsPerSample == 0 || bitsPerSample == 8) &&
+                (bitsPerPixel == 0 || bitsPerPixel == 24) && !planar;
+    }
+    // Requests for deep color or other color models use the actual closest
+    // supported window depth; exactMatch records that conversion is needed.
+    return availableWindowDepths[0];
+}
