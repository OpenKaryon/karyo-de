+// A representation may expose a natural CGImage through the modern selector.
+// The base NSImageRep drawing method is a no-op; do not manufacture a blank
+// fallback bitmap for representations without a supported image conversion.
+@interface NSImageRep (DarlingNaturalCGImage)
+- (CGImageRef) CGImageForProposedRect: (NSRect *) proposedDestRect
+                            context: (NSGraphicsContext *) referenceContext
+                              hints: (NSDictionary *) hints;
+@end
+
 @implementation NSImage
 
 + (NSArray *) imageFileTypes {
@@ -707,6 +716,29 @@
 - (BOOL) isValid {
     NSUnimplementedMethod();
     return 0;
+}
+
+- (CGImageRef) CGImageForProposedRect: (NSRect *) proposedDestRect
+                            context: (NSGraphicsContext *) referenceContext
+                              hints: (NSDictionary *) hints
+{
+    // These arguments are optional selection hints. A natural existing bitmap
+    // is valid without resampling or changing the caller's context or rect.
+    for (NSImageRep *rep in _representations) {
+        CGImageRef image = NULL;
+        if ([rep respondsToSelector: @selector(CGImageForProposedRect:context:hints:)]) {
+            image = [rep CGImageForProposedRect: proposedDestRect
+                                      context: referenceContext hints: hints];
+        } else if ([rep isKindOfClass: [NSBitmapImageRep class]]) {
+            image = [(NSBitmapImageRep *) rep CGImage];
+        }
+        if (image != NULL) {
+            // The caller may release NSImage/its representation immediately.
+            // This +0 lease still keeps the actual CGImage alive until drain.
+            return (CGImageRef) [(id) CGImageRetain(image) autorelease];
+        }
+    }
+    return NULL;
 }
 
