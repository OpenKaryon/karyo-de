--- /dev/null
+++ b/src/startup/mldr/elfcalls/native_threads.c
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE 1
+#endif
+#include <dlfcn.h>
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+
+typedef int (*native_create_fn)(pthread_t *, const pthread_attr_t *,
+                               void *(*)(void *), void *);
+static native_create_fn native_create;
+static pthread_once_t resolve_once = PTHREAD_ONCE_INIT;
+
+static void resolve_native_create(void)
+{
+    native_create = (native_create_fn)dlsym(RTLD_NEXT, "pthread_create");
+}
+
+/* Linux libraries can create workers without Darwin thread state. Keep the
+ * two process-directed signals handled directly by the Darwin trampoline out
+ * of those workers. A real Darwin thread restores its creator's original mask
+ * only after its RPC socket and Darwin thread state have been registered.
+ */
+int pthread_create(pthread_t *thread, const pthread_attr_t *attributes,
+                   void *(*entry)(void *), void *argument)
+{
+    int status = pthread_once(&resolve_once, resolve_native_create);
+    if (status != 0)
+        return status;
+    if (native_create == NULL)
+        return ENOSYS;
+
+    sigset_t blocked, inherited;
+    sigemptyset(&blocked);
+    sigaddset(&blocked, SIGCHLD);
+    sigaddset(&blocked, SIGTTOU);
+    status = pthread_sigmask(SIG_BLOCK, &blocked, &inherited);
+    if (status != 0)
+        return status;
+    status = native_create(thread, attributes, entry, argument);
+    /* inherited is a mask returned by this same POSIX implementation. */
+    (void)pthread_sigmask(SIG_SETMASK, &inherited, NULL);
+    return status;
+}
