+static O2argb8u *O2ImageRead_XBGR8888_to_argb8u(O2Image *self, int x, int y,
+                                                 O2argb8u *span, int length) {
+    const uint8_t *bytes = scanlineAtY(self, y);
+    if (bytes == NULL) return NULL;
+    bytes += x * 4;
+    for (int i = 0; i < length; i++, bytes += 4) {
+        span[i].a = 255;
+        span[i].b = bytes[1];
+        span[i].g = bytes[2];
+        span[i].r = bytes[3];
+    }
+    return NULL;
+}
+
+static O2argb8u *O2ImageRead_RGBX8888_to_argb8u(O2Image *self, int x, int y,
+                                                 O2argb8u *span, int length) {
+    const uint8_t *bytes = scanlineAtY(self, y);
+    if (bytes == NULL) return NULL;
+    bytes += x * 4;
+    for (int i = 0; i < length; i++, bytes += 4) {
+        span[i].a = 255;
+        span[i].r = bytes[0];
+        span[i].g = bytes[1];
+        span[i].b = bytes[2];
+    }
+    return NULL;
+}
+
+static O2argb8u *O2ImageRead_float_to_argb8u(O2Image *self, int x, int y,
+                                               O2argb8u *span, int length) {
+    O2argb32f floats[length];
+    O2argb32f *direct = self->_read_argb32f(self, x, y, floats, length);
+    if (direct != NULL) {
+        for (int i = 0; i < length; i++) floats[i] = direct[i];
+    }
+    for (int i = 0; i < length; i++) {
+        span[i].a = O2ByteFromFloat(floats[i].a);
+        span[i].r = O2ByteFromFloat(floats[i].r);
+        span[i].g = O2ByteFromFloat(floats[i].g);
+        span[i].b = O2ByteFromFloat(floats[i].b);
     }
     return NULL;
 }
