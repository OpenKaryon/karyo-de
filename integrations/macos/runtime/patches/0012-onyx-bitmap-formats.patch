+static void O2SurfaceWrite_argb8u_to_argb32f(O2Surface *self, int x, int y,
+                                               O2argb8u *span, int length) {
+    O2argb32f floats[length];
+    for (int i = 0; i < length; i++) {
+        floats[i].a = span[i].a / 255.0f;
+        floats[i].r = span[i].r / 255.0f;
+        floats[i].g = span[i].g / 255.0f;
+        floats[i].b = span[i].b / 255.0f;
+    }
+    self->_writeargb32f(self, x, y, floats, length);
+}
+
+static void O2SurfaceWrite_argb8u_to_skip32(O2Surface *self, int x, int y,
+                                              O2argb8u *span, int length) {
+    uint8_t *bytes = self->_pixelBytes + y * self->_bytesPerRow + x * 4;
+    O2BitmapInfo order = self->_bitmapInfo & kO2BitmapByteOrderMask;
+    BOOL little = order == kO2BitmapByteOrder16Little ||
+                  order == kO2BitmapByteOrder32Little;
+    if (order == kO2BitmapByteOrderDefault) {
+#ifdef __LITTLE_ENDIAN__
+        little = YES;
+#endif
+    }
+    BOOL first = (self->_bitmapInfo & kO2BitmapAlphaInfoMask) == kO2ImageAlphaNoneSkipFirst;
+    for (int i = 0; i < length; i++, bytes += 4) {
+        if (first && little) {
+            bytes[0] = span[i].b; bytes[1] = span[i].g;
+            bytes[2] = span[i].r; bytes[3] = 255;
+        } else if (first) {
+            bytes[0] = 255; bytes[1] = span[i].r;
+            bytes[2] = span[i].g; bytes[3] = span[i].b;
+        } else if (little) {
+            bytes[0] = 255; bytes[1] = span[i].b;
+            bytes[2] = span[i].g; bytes[3] = span[i].r;
+        } else {
+            bytes[0] = span[i].r; bytes[1] = span[i].g;
+            bytes[2] = span[i].b; bytes[3] = 255;
+        }
+    }
+}
