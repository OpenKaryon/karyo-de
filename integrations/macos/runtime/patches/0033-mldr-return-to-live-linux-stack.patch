Subject: Return terminated Darwin threads to their live Linux stack frame

Use the native libc longjmp ABI at the deliberate disjoint-stack transition.
Keep the ordinary compilation options and all unrelated call sites unchanged.

--- a/src/startup/mldr/elfcalls/threads.c
+++ b/src/startup/mldr/elfcalls/threads.c
@@ -42,6 +42,12 @@
 
 // The point of this file is build macOS threads on top of native libc's threads,
 // otherwise it would not be possible to make native calls from these threads.
+
+// The saved Linux frame remains live while the Darwin thread runs on its own
+// allocation. Return across these stacks with the native libc ABI: the fortified
+// longjmp wrapper assumes one contiguous stack and rejects this valid transfer.
+extern void __mldr_return_to_linux_stack(jmp_buf, int)
+    __asm__("longjmp") __attribute__((noreturn));
 
 static __thread jmp_buf t_jmpbuf;
 static __thread void* t_freeaddr;
@@ -367,7 +373,7 @@
 	t_freeaddr = stackaddr;
 	t_freesize = freesize;
 
-	longjmp(t_jmpbuf, 1);
+	__mldr_return_to_linux_stack(t_jmpbuf, 1);
 
 	__builtin_unreachable();
 }
