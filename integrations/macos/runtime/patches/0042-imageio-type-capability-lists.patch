Subject: Export ImageIO decoder and encoder capability lists

Report the decoder classes actually present and only implemented encoders,
with retained arrays under the Copy ownership contract.

--- a/src/frameworks/ImageIO/src/CGImageSource.m
+++ b/src/frameworks/ImageIO/src/CGImageSource.m
@@ -1,2 +1,3 @@
 #import <ImageIO/CGImageSource.h>
+#import <Foundation/Foundation.h>
 #import <Onyx2D/O2ImageSource.h>
@@ -12,2 +13,17 @@
 @end
+
+CFArrayRef CGImageSourceCopyTypeIdentifiers(void) {
+    NSMutableArray *types = [NSMutableArray array];
+    NSString *classes[] = {@"O2ImageSource_PNG", @"O2ImageSource_TIFF",
+                          @"O2ImageSource_JPEG", @"O2ImageSource_BMP",
+                          @"O2ImageSource_GIF", @"O2ImageSource_ICNS"};
+    NSString *utis[] = {@"public.png", @"public.tiff", @"public.jpeg",
+                       @"com.microsoft.bmp", @"com.compuserve.gif",
+                       @"com.apple.icns"};
+    for (NSUInteger i = 0; i < sizeof(classes) / sizeof(classes[0]); i++) {
+        if (NSClassFromString(classes[i]) != Nil)
+            [types addObject: utis[i]];
+    }
+    return (CFArrayRef) [types copy];
+}
 
