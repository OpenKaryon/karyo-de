Subject: Resolve single IOKit service queries through the registry

Use the registered matching-service iterator for the public single-result RPC.
Remove its unsupported stub and honor IOKit ownership of the matching dictionary.
This is a common service contract, without application-name selection.

--- a/src/external/iokitd/src/ServiceRegistry.mm
+++ b/src/external/iokitd/src/ServiceRegistry.mm
@@ -118,3 +118,41 @@
     // Old unsupported API
     return kIOReturnUnsupported;
 }
+
+// Return the first object from the same registry query used by enumeration.
+kern_return_t is_io_service_get_matching_service_bin
+(
+    mach_port_t master_port,
+    io_struct_inband_t matching,
+    mach_msg_type_number_t matchingCnt,
+    mach_port_t *service
+)
+{
+    *service = MACH_PORT_NULL;
+    CFStringRef errorString = nullptr;
+    CFTypeRef criteria = nullptr;
+    try
+    {
+        criteria = IOCFUnserializeBinary(matching, matchingCnt, nullptr, 0, &errorString);
+        if (!criteria)
+            throwCFStringException(CFSTR("io_service_get_matching_service_bin(): cannot parse 'matching': %@"), errorString);
+        if (CFGetTypeID(criteria) != CFDictionaryGetTypeID())
+            throw std::runtime_error("io_service_get_matching_service_bin(): dictionary expected");
+
+        IOIterator* iterator = ServiceRegistry::instance()->iteratorForMatchingServices((NSDictionary*) criteria);
+        CFRelease(criteria);
+        criteria = nullptr;
+        IOObject* first = iterator->next();
+        if (first)
+            *service = first->port();
+        iterator->releaseLater();
+        return first ? kIOReturnSuccess : kIOReturnNoDevice;
+    }
+    catch (const std::exception& e)
+    {
+        os_log_error(OS_LOG_DEFAULT, "is_io_service_get_matching_service_bin: %s", e.what());
+        if (criteria) CFRelease(criteria);
+        if (errorString) CFRelease(errorString);
+        return kIOReturnBadArgument;
+    }
+}
