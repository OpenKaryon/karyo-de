diff --git a/src/external/cocotron/AppKit/NSApplication.m b/src/external/cocotron/AppKit/NSApplication.m
--- a/src/external/cocotron/AppKit/NSApplication.m
+++ b/src/external/cocotron/AppKit/NSApplication.m
@@ -923,6 +923,13 @@
 
 - (void) updateWindows {
     [_windows makeObjectsPerformSelector: @selector(update)];
+}
+
+// Full Keyboard Access includes non-text controls when bit 1 is set.
+// Read the current preference on every query, as AppKit specifies.
+- (BOOL) isFullKeyboardAccessEnabled {
+    return ([[NSUserDefaults standardUserDefaults]
+                    integerForKey: @"AppleKeyboardUIMode"] & 0x2) != 0;
 }
 
 - (void) activateIgnoringOtherApps: (BOOL) flag {
