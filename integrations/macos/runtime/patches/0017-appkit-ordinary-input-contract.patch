+
 - (NSInteger) buttonNumber {
-    return _buttonNumber;
+    // Left/right NSEvent types identify the button independently of
+    // the backend numbering; Cocoa uses zero for left and one for right.
+    switch (_type) {
+    case NSLeftMouseDown:
+    case NSLeftMouseUp:
+    case NSLeftMouseDragged:
+        return 0;
+    case NSRightMouseDown:
+    case NSRightMouseUp:
+    case NSRightMouseDragged:
