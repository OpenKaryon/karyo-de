+IOReturn IOSurfaceRoot::releaseSurface(IOSurfaceID id)
+{
+    auto& mappings = m_processes.at(g_iokitCurrentCallerPID).surfaces;
+    auto entry = mappings.find(id);
+    auto surface = m_surfaces.find(id);
+    if (entry == mappings.end() || surface == m_surfaces.end()) return KERN_INVALID_ARGUMENT;
+    IOSurface* object = surface->second;
+    if (--entry->second.references == 0) {
+        while (entry->second.useCount) {
+            object->decrementUseCount(); --entry->second.useCount;
+        }
+        mappings.erase(entry);
+    }
+    object->dropReference();
+    return KERN_SUCCESS;
+}
+
+IOReturn IOSurfaceRoot::lockSurface(const _IOSurfaceLockUnlock* input, void* output, IOByteCount inputCount, IOByteCount* outputCount)
+{
+    if (inputCount != sizeof(*input) || *outputCount < sizeof(uint32_t)) return KERN_INVALID_ARGUMENT;
+    auto& mappings = m_processes.at(g_iokitCurrentCallerPID).surfaces;
+    auto surface = m_surfaces.find(input->surfaceID);
+    if (!mappings.count(input->surfaceID) || surface == m_surfaces.end()) return KERN_INVALID_ARGUMENT;
+    surface->second->lock();
+    uint32_t seed = surface->second->seed();
+    std::memcpy(output, &seed, sizeof(seed)); *outputCount = sizeof(seed);
+    return KERN_SUCCESS;
+}
+
+IOReturn IOSurfaceRoot::unlockSurface(const _IOSurfaceLockUnlock* input, void* output, IOByteCount inputCount, IOByteCount* outputCount)
+{
+    if (inputCount != sizeof(*input) || *outputCount < sizeof(uint32_t)) return KERN_INVALID_ARGUMENT;
+    auto& mappings = m_processes.at(g_iokitCurrentCallerPID).surfaces;
+    auto surface = m_surfaces.find(input->surfaceID);
+    if (!mappings.count(input->surfaceID) || surface == m_surfaces.end()) return KERN_INVALID_ARGUMENT;
+    surface->second->unlock((input->options & kIOSurfaceLockReadOnly) != 0);
+    uint32_t seed = surface->second->seed();
+    std::memcpy(output, &seed, sizeof(seed)); *outputCount = sizeof(seed);
+    return KERN_SUCCESS;
+}
+
+IOReturn IOSurfaceRoot::lookupById(IOSurfaceID id, void* output, IOByteCount* outputCount)
+{
+    if (*outputCount < sizeof(_IOSurfaceObjectRetval)) return KERN_NO_SPACE;
+    auto entry = m_surfaces.find(id);
+    if (entry == m_surfaces.end()) return KERN_INVALID_ARGUMENT;
+    auto& mappings = m_processes.at(g_iokitCurrentCallerPID).surfaces;
+    IOSurface* surface = entry->second;
+    if (!mappings.count(id) && !surface->isGlobal()) return KERN_INVALID_ARGUMENT;
+    auto& mapping = mappings[id];
+    surface->acquireReference(); ++mapping.references;
+    std::memcpy(output, &surface->description(), sizeof(_IOSurfaceObjectRetval));
+    *outputCount = sizeof(_IOSurfaceObjectRetval);
+    return KERN_SUCCESS;
+}
+
+IOReturn IOSurfaceRoot::incrementSurfaceUseCount(IOSurfaceID id)
+{
+    auto& mappings = m_processes.at(g_iokitCurrentCallerPID).surfaces;
+    auto entry = mappings.find(id); auto surface = m_surfaces.find(id);
+    if (entry == mappings.end() || surface == m_surfaces.end()) return KERN_INVALID_ARGUMENT;
+    surface->second->incrementUseCount(); ++entry->second.useCount;
+    return KERN_SUCCESS;
+}
+
+IOReturn IOSurfaceRoot::decrementSurfaceUseCount(IOSurfaceID id)
+{
+    auto& mappings = m_processes.at(g_iokitCurrentCallerPID).surfaces;
+    auto entry = mappings.find(id); auto surface = m_surfaces.find(id);
+    if (entry == mappings.end() || surface == m_surfaces.end() || !entry->second.useCount)
+        return KERN_INVALID_ARGUMENT;
+    surface->second->decrementUseCount(); --entry->second.useCount;
+    return KERN_SUCCESS;
+}
