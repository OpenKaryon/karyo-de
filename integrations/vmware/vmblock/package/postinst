#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
case "${1:-}" in
    configure)
        deb-systemd-helper unmask karyo-vmblock-shutdown.service >/dev/null || true
        if deb-systemd-helper --quiet was-enabled karyo-vmblock-shutdown.service; then
            deb-systemd-helper enable karyo-vmblock-shutdown.service >/dev/null || true
        else
            deb-systemd-helper update-state karyo-vmblock-shutdown.service >/dev/null || true
        fi
        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload
            deb-systemd-invoke start karyo-vmblock-shutdown.service >/dev/null || true
        fi
        ;;
esac
exit 0
