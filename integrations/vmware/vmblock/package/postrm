#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
case "${1:-}" in
    remove) deb-systemd-helper mask karyo-vmblock-shutdown.service >/dev/null || true ;;
    purge)
        deb-systemd-helper purge karyo-vmblock-shutdown.service >/dev/null || true
        deb-systemd-helper unmask karyo-vmblock-shutdown.service >/dev/null || true
        ;;
esac
if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload
fi
exit 0
