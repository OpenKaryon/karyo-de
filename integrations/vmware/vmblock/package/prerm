#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
case "${1:-}" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop karyo-vmblock-shutdown.service >/dev/null || true
        fi
        ;;
esac
exit 0
