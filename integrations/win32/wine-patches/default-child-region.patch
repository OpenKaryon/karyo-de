+/* Keep the application's explicit region separate from the default visual shape. */
+static struct region *get_window_shape( struct window *win )
+{
+    const unsigned int mask = WS_CHILD | WS_POPUP | WS_CAPTION | WS_MAXIMIZE | WS_MINIMIZE;
+    int width = win->window_rect.right - win->window_rect.left;
+    int height = win->window_rect.bottom - win->window_rect.top;
+    unsigned int error;
+    int scale;
+    struct rectangle bounds, rects[5];
+
+    if (win->win_region) return win->win_region;
+    if ((win->style & mask) != (WS_CHILD | WS_CAPTION) || !win->parent ||
+        is_desktop_window( win->parent ) || (win->ex_style & WS_EX_LAYERED)) return NULL;
+    scale = max( 1, (get_window_dpi( win ) + 48) / 96 );
+    if (width <= 4 * scale || height <= 4 * scale) return NULL;
+
+    if (win->rounded_region)
+    {
+        get_region_extents( win->rounded_region, &bounds );
+        if (bounds.right == width && bounds.bottom == height && win->rounded_scale == (unsigned int)scale)
+            return win->rounded_region;
+        free_region( win->rounded_region );
+    }
+
+    rects[0] = (struct rectangle){ 2 * scale, 0, width - 2 * scale, scale };
+    rects[1] = (struct rectangle){ scale, scale, width - scale, 2 * scale };
+    rects[2] = (struct rectangle){ 0, 2 * scale, width, height - 2 * scale };
+    rects[3] = (struct rectangle){ scale, height - 2 * scale, width - scale, height - scale };
+    rects[4] = (struct rectangle){ 2 * scale, height - scale, width - 2 * scale, height };
+    error = get_error();
+    win->rounded_region = create_region_from_req_data( rects, sizeof(rects) );
+    win->rounded_scale = scale;
+    set_error( error );
+    return win->rounded_region;
+}
