[Desktop Entry]
Type=Application
Name=Windows Applications
Name[ru]=Приложения Windows
Comment=Launch a Windows EXE application or MSI installer
Comment[ru]=Запустить приложение Windows или установщик MSI
Exec=karyo-win32 --gui -- %f
Icon=application-x-ms-dos-executable
Terminal=false
Categories=System;Utility;
