 static struct wlr_xwayland_surface *
+native_top_parent(struct wlr_xwayland_surface *surface)
+{
+	while (surface->parent) {
+		surface = surface->parent;
+	}
+	return surface;
+}
+
+static bool
+is_fixed_size(struct wlr_xwayland_surface *surface)
+{
+	xcb_size_hints_t *hints = surface->size_hints;
+	const uint32_t flags = XCB_ICCCM_SIZE_HINT_P_MIN_SIZE
+		| XCB_ICCCM_SIZE_HINT_P_MAX_SIZE;
+	return hints && (hints->flags & flags) == flags
+		&& hints->min_width == hints->max_width
+		&& hints->min_height == hints->max_height;
+}
+
+static struct wlr_xwayland_surface *
 top_parent_of(struct view *view)
 {
-	struct wlr_xwayland_surface *s = xwayland_surface_from_view(view);
-	while (s->parent) {
-		s = s->parent;
-	}
-	return s;
+	struct wlr_xwayland_surface *surface = xwayland_surface_from_view(view);
+	struct wlr_xwayland_surface *owner = native_top_parent(surface);
+	const char *application_class = owner->class;
+	/* An unmapped X11 owner may have no WM_CLASS yet. Borrow only from
+	 * its same-process visible sibling; keep every other group guard. */
+	if (!application_class && !owner->surface) {
+		application_class = surface->class;
+	}
+	/* Legacy Win32 frameworks put their main frame and fixed palettes
+	 * under one invisible application owner. Preserve the client's real
+	 * ownership hints and select only an unambiguous stacking frame. */
+	if (surface == owner || owner->width > 1 || owner->height > 1
+			|| owner->decorations == WLR_XWAYLAND_SURFACE_DECORATIONS_ALL
+			|| !application_class || owner->pid <= 0 || surface->pid != owner->pid
+			|| !surface->class || strcasecmp(surface->class, application_class)) {
+		return owner;
+	}
+	size_t length = strlen(application_class);
+	if (length < 5 || strcasecmp(application_class + length - 4, ".exe")) {
+		return owner;
+	}
+	struct wlr_xwayland_surface *frame = NULL;
+	struct view *candidate;
+	wl_list_for_each(candidate, &view->server->views, link) {
+		if (candidate->type != LAB_XWAYLAND_VIEW
+				|| (!candidate->mapped && !candidate->minimized)) {
+			continue;
+		}
+		struct wlr_xwayland_surface *child = xwayland_surface_from_view(candidate);
+		if (child == owner || native_top_parent(child) != owner
+				|| child->pid != owner->pid || !child->class
+				|| strcasecmp(child->class, application_class)) {
+			continue;
+		}
+		bool normal = xwayland_surface_contains_window_type(child,
+			NET_WM_WINDOW_TYPE_NORMAL);
+		if (normal && child->decorations == WLR_XWAYLAND_SURFACE_DECORATIONS_ALL) {
+			if (frame) {
+				return owner;
+			}
+			frame = child;
+		} else if (normal && !is_fixed_size(child)) {
+			return owner;
+		}
+	}
+	return frame ? frame : owner;
 }
 
