From: Karyo Developers <developers@openkaryon.invalid>
Subject: Start protected sessions in the existing abandoned-lock state
License: GPL-2.0-only (derivative of labwc src/main.c)

A startup locker runs asynchronously after the compositor socket opens. Keep
outputs and normal input locked from backend startup until the session-lock
client explicitly unlocks; a missing or failed client must leave a blank lock.

--- a/src/main.c
+++ b/src/main.c
@@ -10,6 +10,7 @@
 #include "common/spawn.h"
 #include "config/session.h"
 #include "labwc.h"
+#include "session-lock.h"
 #include "theme.h"
 #include "menu/menu.h"
 
@@ -21,6 +22,7 @@
 	{"debug", no_argument, NULL, 'd'},
 	{"exit", no_argument, NULL, 'e'},
 	{"help", no_argument, NULL, 'h'},
+	{"startup-lock", no_argument, NULL, 256},
 	{"merge-config", no_argument, NULL, 'm'},
 	{"reconfigure", no_argument, NULL, 'r'},
 	{"startup", required_argument, NULL, 's'},
@@ -37,6 +39,7 @@
 "  -d, --debug              Enable full logging, including debug information\n"
 "  -e, --exit               Exit the compositor\n"
 "  -h, --help               Show help message and quit\n"
+"      --startup-lock       Blank and inhibit input until a session-lock client unlocks\n"
 "  -m, --merge-config       Merge user config files/theme in all XDG Base Dirs\n"
 "  -r, --reconfigure        Reload the compositor configuration\n"
 "  -s, --startup <command>  Run command on startup\n"
@@ -112,6 +115,7 @@
 int
 main(int argc, char *argv[])
 {
+	bool startup_locked = false;
 	char *startup_cmd = NULL;
 	char *primary_client = NULL;
 	enum wlr_log_importance verbosity = WLR_ERROR;
@@ -124,6 +128,9 @@
 			break;
 		}
 		switch (c) {
+		case 256:
+			startup_locked = true;
+			break;
 		case 'c':
 			rc.config_file = optarg;
 			break;
@@ -207,6 +214,13 @@
 
 	struct server server = { 0 };
 	server_init(&server);
+	/*
+	 * Use the existing abandoned-lock state before any output or client can
+	 * become active. New outputs are blanked immediately and normal input
+	 * remains inhibited. A real ext-session-lock client adopts this state;
+	 * its failure or disconnect never releases the compositor lock.
+	 */
+	server.session_lock_manager->locked = startup_locked;
 	server_start(&server);
 
 	struct theme theme = { 0 };
