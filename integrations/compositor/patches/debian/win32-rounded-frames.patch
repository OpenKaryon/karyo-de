+ssd_should_round_bottom(const struct ssd *ssd)
+{
+	struct view *view = ssd->view;
+	return ssd->theme->windows_frame && view_is_floating(view)
+		&& !view->shaded && ssd->titlebar.height > 0
+		&& view->current.width >= 2 * WINDOWS_FRAME_RADIUS
+		&& view->current.height >= WINDOWS_FRAME_RADIUS;
