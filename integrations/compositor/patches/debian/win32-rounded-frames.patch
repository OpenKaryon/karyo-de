+void
+ssd_update_client_clip(struct ssd *ssd)
+{
+	if (!ssd || !ssd->theme->windows_frame) {
+		return;
+	}
+	struct view *view = ssd->view;
+	int border = ssd->theme->border_width;
+	int top = view_is_floating(view) && ssd->titlebar.height > 0
+		? WINDOWS_FRAME_RADIUS : 0;
+	/* Include button hitboxes, not shadows or resize extents. */
+	lab_wlr_scene_set_rounded_clip(&ssd->titlebar.tree->node,
+		-border, -ssd->titlebar.height - border,
+		view->current.width + 2 * border, ssd->titlebar.height + border, top, 0);
+	if (view->content_tree) {
+		int bottom = ssd_should_round_bottom(ssd) ? MAX(0, WINDOWS_FRAME_RADIUS - border) : 0;
+		lab_wlr_scene_set_rounded_clip(&view->content_tree->node, 0, 0,
+			view->current.width, view->current.height, 0, bottom);
+	}
+}
