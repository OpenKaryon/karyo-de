 static void
+update_window_clip(struct view *view)
+{
+	if (!view->surface || !view->content_tree) {
+		return;
+	}
+	struct wlr_scene_node *node = &view->content_tree->node;
+	if (!ssd_uses_windows_frame(view)) {
+		wlr_scene_node_set_clip_region(node, NULL);
+		return;
+	}
+	if (view->ssd) {
+		ssd_update_client_clip(view->ssd);
+		return;
+	}
+	struct wlr_xwayland_surface *surface = xwayland_surface_from_view(view);
+	bool tool = xwayland_view_contains_window_type(view, NET_WM_WINDOW_TYPE_DIALOG)
+		|| xwayland_view_contains_window_type(view, NET_WM_WINDOW_TYPE_UTILITY);
+	int radius = surface->parent && tool && !surface->override_redirect
+		&& !surface->has_alpha && view_is_floating(view) ? 4 : 0;
+	lab_wlr_scene_set_rounded_clip(node, 0, 0, view->current.width,
+		view->current.height, radius, radius);
+}
