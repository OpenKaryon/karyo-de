+const char *
+desktop_entry_win32_id(struct server *server, const char *app_id)
+{
+	struct sfdo *sfdo = server->sfdo;
+	if (!sfdo || !is_win32_app_id(app_id)) {
+		return app_id;
+	}
+	refresh_win32_desktop_entries(sfdo, app_id);
+	struct sfdo_desktop_entry *entry = get_desktop_entry(sfdo, app_id);
+	const char *id = entry ? sfdo_desktop_entry_get_id(entry, NULL) : NULL;
+	return id && !strncmp(id, "karyo-win32-", 12) ? id : app_id;
+}
