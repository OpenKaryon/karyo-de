  * Usually this function just enables all the nodes for buttons, but some
  * buttons can be hidden for small windows (e.g. xterm -geometry 1x1).
  */
+static int
+buttons_width(const struct theme *theme, struct wl_list *list, int count, bool reverse)
+{
+	int width = 0;
+	struct wl_list *item = reverse ? list->prev : list->next;
+	for (int i = 0; i < count; ++i) {
+		struct title_button *button = wl_container_of(item, button, link);
+		width += ssd_title_button_width(theme, button->type) + theme->window_button_spacing;
+		item = reverse ? item->prev : item->next;
+	}
+	return width;
+}
