+struct scene_clip {
+	struct wlr_addon addon;
+	pixman_region32_t region;
+};
+
+static void scene_clip_destroy(struct wlr_addon *addon) {
+	struct scene_clip *clip = wl_container_of(addon, clip, addon);
+	wlr_addon_finish(addon);
+	pixman_region32_fini(&clip->region);
+	free(clip);
+}
+
+static const struct wlr_addon_interface scene_clip_impl = {
+	.name = "scene_clip_region",
+	.destroy = scene_clip_destroy,
+};
+
+static struct scene_clip *scene_node_get_clip(struct wlr_scene_node *node) {
+	struct wlr_addon *addon = wlr_addon_find(&node->addons, node, &scene_clip_impl);
+	struct scene_clip *clip = NULL;
+	return addon ? wl_container_of(addon, clip, addon) : NULL;
+}
+
+static void scene_node_apply_clip(struct wlr_scene_node *node, int lx, int ly,
+		pixman_region32_t *region) {
+	for (;;) {
+		struct scene_clip *clip = scene_node_get_clip(node);
+		if (clip) {
+			pixman_region32_translate(region, -lx, -ly);
+			pixman_region32_intersect(region, region, &clip->region);
+			pixman_region32_translate(region, lx, ly);
+		}
+		if (!node->parent) {
+			return;
+		}
+		lx -= node->x;
+		ly -= node->y;
+		node = &node->parent->node;
+	}
+}
