+void wlr_scene_node_set_clip_region(struct wlr_scene_node *node,
+		const pixman_region32_t *region) {
+	struct scene_clip *clip = scene_node_get_clip(node);
+	if (!region) {
+		if (!clip) {
+			return;
+		}
+		scene_clip_destroy(&clip->addon);
+	} else {
+		if (clip && pixman_region32_equal(&clip->region, region)) {
+			return;
+		}
+		if (!clip) {
+			clip = calloc(1, sizeof(*clip));
+			if (!clip) {
+				return;
+			}
+			pixman_region32_init(&clip->region);
+			wlr_addon_init(&clip->addon, &node->addons, node, &scene_clip_impl);
+		}
+		pixman_region32_copy(&clip->region, region);
+	}
+	scene_node_update(node, NULL);
 }
 
