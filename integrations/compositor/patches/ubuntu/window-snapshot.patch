+
+/* Walk the enabled scene from front to back. Unlike the view/MRU list this
+ * preserves actual stacking, always-on-top/bottom groups and workspaces. */
+static void
+snapshot_node(struct wl_resource *resource, struct wlr_scene_node *node)
+{
+	if (!node->enabled) {
+		return;
+	}
+	struct node_descriptor *desc = node->data;
+	if (desc && desc->type == LAB_NODE_VIEW) {
+		struct view *view = desc->view;
+		if (!view->mapped || view->minimized || !view->surface) {
+			return;
+		}
+		struct wlr_box box = ssd_max_extents(view);
+		const char *title = view->title;
+		if (box.width > 0 && box.height > 0) {
+			openkaryon_window_snapshot_v1_send_window(resource,
+				box.x, box.y, box.width, box.height, title ? title : "");
+		}
+		return;
+	}
+	if (node->type == WLR_SCENE_NODE_TREE) {
+		struct wlr_scene_tree *tree = wlr_scene_tree_from_node(node);
+		struct wlr_scene_node *child;
+		wl_list_for_each_reverse(child, &tree->children, link) {
+			snapshot_node(resource, child);
+		}
+	}
+}
+
+static void
+snapshot_request(struct wl_client *client, struct wl_resource *resource)
+{
+	struct server *server = wl_resource_get_user_data(resource);
+	if (server->session_lock_manager->locked) {
+		openkaryon_window_snapshot_v1_send_done(resource, 0);
+		return;
+	}
+	snapshot_node(resource, &server->scene->tree.node);
+	openkaryon_window_snapshot_v1_send_done(resource, 1);
+}
+
+static void
+snapshot_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+	wl_resource_destroy(resource);
+}
+
+static const struct openkaryon_window_snapshot_v1_interface snapshot_impl = {
+	.destroy = snapshot_destroy,
+	.snapshot = snapshot_request,
+};
+
+static void
+snapshot_bind(struct wl_client *client, void *data, uint32_t version, uint32_t id)
+{
+	struct wl_resource *resource = wl_resource_create(client,
+		&openkaryon_window_snapshot_v1_interface, 1, id);
+	if (!resource) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+	wl_resource_set_implementation(resource, &snapshot_impl, data, NULL);
+}
+
+void
+window_snapshot_control_init(struct server *server)
+{
+	if (!wl_global_create(server->wl_display,
+			&openkaryon_window_snapshot_v1_interface, 1, server, snapshot_bind)) {
+		wlr_log(WLR_ERROR, "Unable to create window snapshot control");
+	}
+}
 
