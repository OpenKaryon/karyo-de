+/*
+ * Desktop panels must change the physical group, not a virtual keyboard's
+ * private keymap. This preserves the usual modifier broadcasts and the
+ * per-window group stored by view_set_activated().
+ */
+static void
+layout_control_cycle(struct wl_client *client, struct wl_resource *resource,
+		struct wl_resource *seat_resource)
+{
+	struct server *server = wl_resource_get_user_data(resource);
+	struct wlr_seat_client *seat_client = wlr_seat_client_from_resource(seat_resource);
+	if (server->session_lock_manager->locked
+			|| !seat_client || seat_client->seat != server->seat.seat) {
+		return;
+	}
+	struct seat *seat = &server->seat;
+	struct input *input;
+	wl_list_for_each(input, &seat->inputs, link) {
+		if (input->wlr_input_device->type != WLR_INPUT_DEVICE_KEYBOARD) {
+			continue;
+		}
+		struct keyboard *keyboard = (struct keyboard *)input;
+		if (keyboard->is_virtual) {
+			continue;
+		}
+		struct wlr_keyboard *kb = keyboard->wlr_keyboard;
+		if (!kb || !kb->keymap) {
+			return;
+		}
+		xkb_layout_index_t count = xkb_keymap_num_layouts(kb->keymap);
+		if (count > 1) {
+			keyboard_update_layout(seat, (kb->modifiers.group + 1) % count);
+		}
+		return;
+	}
+}
+
+static void
+layout_control_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+	wl_resource_destroy(resource);
+}
+
+static const struct openkaryon_keyboard_layout_v1_interface layout_control_impl = {
+	.destroy = layout_control_destroy,
+	.cycle = layout_control_cycle,
+};
+
+static void
+layout_control_bind(struct wl_client *client, void *data, uint32_t version,
+		uint32_t id)
+{
+	struct wl_resource *resource = wl_resource_create(client,
+		&openkaryon_keyboard_layout_v1_interface, 1, id);
+	if (!resource) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+	wl_resource_set_implementation(resource, &layout_control_impl, data, NULL);
+}
+
+void
+keyboard_layout_control_init(struct server *server)
+{
+	if (!wl_global_create(server->wl_display,
+			&openkaryon_keyboard_layout_v1_interface, 1, server,
+			layout_control_bind)) {
+		wlr_log(WLR_ERROR, "Unable to create keyboard layout control");
+	}
+}
