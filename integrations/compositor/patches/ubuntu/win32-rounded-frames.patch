+static void
+subtract_corner_rows(pixman_region32_t *clip, int width, int height, int radius, bool top)
+{
+	int diameter = 2 * radius;
+	for (int row = 0; row < radius; ++row) {
+		int dy = 2 * row + 1;
+		int inset = 0;
+		for (int dx = diameter - 1; dx * dx + dy * dy > diameter * diameter; dx -= 2) {
+			++inset;
+		}
+		if (!inset) {
+			continue;
+		}
+		int y = top ? radius - 1 - row : height - radius + row;
+		pixman_region32_t edge;
+		pixman_region32_init_rect(&edge, 0, y, inset, 1);
+		pixman_region32_union_rect(&edge, &edge, width - inset, y, inset, 1);
+		pixman_region32_subtract(clip, clip, &edge);
+		pixman_region32_fini(&edge);
+	}
+}
+
+void
+lab_wlr_scene_set_rounded_clip(struct wlr_scene_node *node, int x, int y,
+		int width, int height, int top_radius, int bottom_radius)
+{
+	if (width <= 0 || height <= 0) {
+		wlr_scene_node_set_clip_region(node, NULL);
+		return;
+	}
+	int limit = MIN(width / 2, height / 2);
+	top_radius = MIN(MAX(top_radius, 0), limit);
+	bottom_radius = MIN(MAX(bottom_radius, 0), limit);
+	if (!top_radius && !bottom_radius) {
+		wlr_scene_node_set_clip_region(node, NULL);
+		return;
+	}
+	pixman_region32_t clip;
+	pixman_region32_init_rect(&clip, 0, 0, width, height);
+	subtract_corner_rows(&clip, width, height, top_radius, true);
+	subtract_corner_rows(&clip, width, height, bottom_radius, false);
+	pixman_region32_translate(&clip, x, y);
+	wlr_scene_node_set_clip_region(node, &clip);
+	pixman_region32_fini(&clip);
+}
