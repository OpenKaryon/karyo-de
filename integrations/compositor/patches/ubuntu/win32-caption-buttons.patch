  * Usually this function just enables all the nodes for buttons, but some
  * buttons can be hidden for small windows (e.g. xterm -geometry 1x1).
  */
+static int
+buttons_width(const struct theme *theme, const enum lab_node_type *buttons,
+		int count, int total, bool reverse)
+{
+	int width = 0;
+	for (int i = 0; i < count; ++i) {
+		int index = reverse ? total - i - 1 : i;
+		width += ssd_title_button_width(theme, buttons[index]) + theme->window_button_spacing;
+	}
+	return width;
+}
