+static struct theme *
+select_view_theme(struct view *view)
+{
+	if (view->type == LAB_XWAYLAND_VIEW) {
+		const char *app_id = view->app_id;
+		size_t length = app_id ? strlen(app_id) : 0;
+		if (length > 4 && !strcasecmp(app_id + length - 4, ".exe")) {
+			return view->server->windows_theme;
+		}
+	}
+	return view->server->theme;
+}
+
+struct theme *
+ssd_theme(struct view *view)
+{
+	return view->ssd ? view->ssd->theme : select_view_theme(view);
+}
+
+void
+ssd_update_app_theme(struct view *view)
+{
+	if (!view->ssd || view->ssd->theme == select_view_theme(view)) {
+		return;
+	}
+	view_reload_ssd(view);
+	if (view->mapped) {
+		view_adjust_for_layout_change(view);
+	}
+}
 
