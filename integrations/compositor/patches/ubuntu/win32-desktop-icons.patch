+static bool
+is_win32_app_id(const char *app_id)
+{
+	size_t length = app_id ? strlen(app_id) : 0;
+	return length > 4 && !strcasecmp(app_id + length - 4, ".exe");
+}
+
+static void
+refresh_win32_desktop_entries(struct sfdo *sfdo, const char *app_id)
+{
+	if (!is_win32_app_id(app_id)) {
+		return;
+	}
+	char *path = g_build_filename(g_get_user_data_dir(), "applications", NULL);
+	struct stat info = {0};
+	int status = stat(path, &info);
+	int error = errno;
+	g_free(path);
+	if (status < 0 && error != ENOENT && error != ENOTDIR) {
+		return;
+	}
+	bool present = status == 0 && S_ISDIR(info.st_mode);
+	const struct stat *old = &sfdo->apps_state;
+	bool unchanged = !present || (info.st_dev == old->st_dev && info.st_ino == old->st_ino
+		&& info.st_mtim.tv_sec == old->st_mtim.tv_sec && info.st_mtim.tv_nsec == old->st_mtim.tv_nsec
+		&& info.st_ctim.tv_sec == old->st_ctim.tv_sec && info.st_ctim.tv_nsec == old->st_ctim.tv_nsec);
+	if (sfdo->apps_known && present == sfdo->apps_present && unchanged) {
+		return;
+	}
+	struct sfdo_desktop_db *updated = sfdo_desktop_db_load(sfdo->desktop_ctx, sfdo->desktop_locale);
+	if (!updated) {
+		return;
+	}
+	sfdo_desktop_db_destroy(sfdo->desktop_db);
+	sfdo->desktop_db = updated;
+	sfdo->apps_state = info;
+	sfdo->apps_present = present;
+	sfdo->apps_known = true;
+}
+
 static struct sfdo_desktop_entry *
 get_desktop_entry(struct sfdo *sfdo, const char *app_id)
 {
@@ -386,6 +436,19 @@
