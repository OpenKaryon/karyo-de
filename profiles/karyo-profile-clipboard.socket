# SPDX-License-Identifier: GPL-3.0-or-later
[Unit]
Description=Karyo family clipboard socket

[Socket]
ListenStream=/run/karyo/clipboard.sock
FileDescriptorName=clipboard
SocketUser=root
SocketGroup=root
SocketMode=0666
DirectoryMode=0755
RemoveOnStop=yes
Backlog=16

[Install]
WantedBy=sockets.target
