#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu
if [ "$#" != 0 ]; then
    echo "karyo-profile-session: this entry accepts no arguments" >&2
    exit 2
fi
uid=$(/usr/bin/id -u)
if [ "$uid" -lt 1000 ] || [ "$uid" -ge 65534 ]; then
    echo "karyo-profile-session: an ordinary local account is required" >&2
    exit 1
fi
# PAM may leave CAP_WAKE_ALARM inherited/ambient. Drop those sets before any
# user preferences or GUI code; keep the bounding set and normal sudo intact.
exec /usr/bin/setpriv --inh-caps=-all --ambient-caps=-all /usr/bin/python3 -I '@CMAKE_INSTALL_FULL_LIBEXECDIR@/karyo/profile-session-wait'
