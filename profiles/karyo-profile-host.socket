# SPDX-License-Identifier: GPL-3.0-or-later
[Unit]
Description=Karyo privileged desktop controller socket

[Socket]
ListenStream=/run/karyo/profiles.sock
FileDescriptorName=profiles
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=yes
Backlog=16

[Install]
WantedBy=sockets.target
