#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# A protected session is already compositor-locked before this script starts.
# Do not launch the shell, FileManager1, autostart clients or bus activations
# until the real PAM lock completes. Refusal/crash must end this compositor.
if ! karyo-lock --on-start; then
    echo "karyo-session: initial desktop authentication did not finish" >&2
    labwc --exit
    exit 1
fi
# Optional application visibility is ordinary user state, prepared after PAM.
# The helper reads administrator metadata and emits one private runtime path.
catalog_environment='XDG_DATA_DIRS XDG_CONFIG_DIRS'
if command -v karyo-application-catalog >/dev/null 2>&1; then
    if ! catalog=$(karyo-application-catalog); then
        echo "karyo-session: profile application catalog did not finish" >&2
        labwc --exit
        exit 1
    fi
    if [ -n "$catalog" ]; then
        export XDG_DATA_DIRS="$catalog/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
        export XDG_CONFIG_DIRS="$catalog/config:${XDG_CONFIG_DIRS:-/etc/xdg}"
        catalog_environment='XDG_DATA_DIRS XDG_CONFIG_DIRS'
    fi
fi
# Optional VMware policy affects only this Karyo session's XDG view.
vmware_ready=0
if command -v karyo-vmware-agent >/dev/null 2>&1; then
    if vmware_config=$(karyo-vmware-agent --config-directory) && [ -n "$vmware_config" ]; then
        export XDG_CONFIG_DIRS="$vmware_config:${XDG_CONFIG_DIRS:-/etc/xdg}"
        case " $catalog_environment " in
            *" XDG_CONFIG_DIRS "*) : ;;
            *) catalog_environment="$catalog_environment XDG_CONFIG_DIRS" ;;
        esac
        vmware_ready=1
    fi
fi
# labwc supplies WAYLAND_DISPLAY after the compositor is ready.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    network_environment=
    if [ -n "${KARYO_NETWORK_ENDPOINT:-}" ]; then
        network_environment='KARYO_NETWORK_ENDPOINT PATH'
    fi
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY \
        XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
        QT_QPA_PLATFORM QT_STYLE_OVERRIDE ${catalog_environment:+$catalog_environment} \
        ${network_environment:+$network_environment} >/dev/null 2>&1 || true
fi
# Optional family sharing runs as this ordinary user, only after startup PAM.
if command -v karyo-profile-clipboard >/dev/null 2>&1; then
    karyo-profile-clipboard &
fi
if [ "$vmware_ready" = 1 ]; then
    karyo-vmware-agent &
fi
# Optional Files claims FileManager1 only if another manager does not own it.
if command -v karyo-files >/dev/null 2>&1; then
    karyo-files --dbus-service &
fi
# Respect freedesktop autostart filtering once per compositor session.
if command -v dex >/dev/null 2>&1; then
    dex --autostart --environment Karyo &
fi
(
    quick=0
    while [ "$quick" -lt 5 ]; do
        started=$(date +%s)
        karyo-shell
        if [ -n "${LABWC_PID:-}" ] && ! kill -0 "$LABWC_PID" 2>/dev/null; then
            exit 0
        fi
        if [ $(($(date +%s) - started)) -lt 10 ]; then
            quick=$((quick + 1))
        else
            quick=0
        fi
        sleep 1
    done
    # An unusable shell returns to the login manager instead of an empty session.
    labwc --exit
) &
