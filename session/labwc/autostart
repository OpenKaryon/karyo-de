#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# labwc supplies WAYLAND_DISPLAY after the compositor is ready.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY \
        XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
        QT_QPA_PLATFORM QT_STYLE_OVERRIDE >/dev/null 2>&1 || true
fi
(
    quick=0
    while [ "$quick" -lt 5 ]; do
        started=$(date +%s)
        karyo-shell
        if [ $(($(date +%s) - started)) -lt 10 ]; then
            quick=$((quick + 1))
        else
            quick=0
        fi
        sleep 1
    done
    # An unusable shell returns to the login manager instead of an empty session.
    labwc --exit
) &
