#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# labwc supplies WAYLAND_DISPLAY after the compositor is ready.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY \
        XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
        QT_QPA_PLATFORM QT_STYLE_OVERRIDE >/dev/null 2>&1 || true
fi
# Optional Files claims FileManager1 only if another manager does not own it.
if command -v karyo-files >/dev/null 2>&1; then
    karyo-files --dbus-service &
fi
# Respect freedesktop autostart filtering once per compositor session.
if command -v dex >/dev/null 2>&1; then
    dex --autostart --environment Karyo &
fi
(
    quick=0
    while [ "$quick" -lt 5 ]; do
        started=$(date +%s)
        karyo-shell
        if [ -n "${LABWC_PID:-}" ] && ! kill -0 "$LABWC_PID" 2>/dev/null; then
            exit 0
        fi
        if [ $(($(date +%s) - started)) -lt 10 ]; then
            quick=$((quick + 1))
        else
            quick=0
        fi
        sleep 1
    done
    # An unusable shell returns to the login manager instead of an empty session.
    labwc --exit
) &
