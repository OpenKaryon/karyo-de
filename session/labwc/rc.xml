<?xml version="1.0"?>
<labwc_config>
  <core><decoration>server</decoration><gap>0</gap></core>
  <theme><cornerRadius>8</cornerRadius></theme>
  <placement><policy>cascade</policy></placement>
  <windowRules>
    <windowRule identifier="karyo-*" serverDecoration="no" />
    <windowRule identifier="openkaryon-*" serverDecoration="no" />
    <windowRule identifier="org.wails.netbird" serverDecoration="yes" />
  </windowRules>
  <keyboard>
    <default />
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="karyo-shell --start" /></keybind>
    <keybind key="W-s"><action name="Execute" command="karyo-shell --start" /></keybind>
    <keybind key="W-l"><action name="Execute" command="karyo-lock" /></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-Down"><action name="Iconify" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
  </keyboard>
  <mouse><default /></mouse>
</labwc_config>
