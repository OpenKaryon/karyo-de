if(NOT KARYO_BUILD_GREETER)
    return()
endif()
find_package(Qt6 REQUIRED COMPONENTS Network)
add_library(karyo-greetd STATIC greeter/greetd.cpp greeter/greetd.h)
target_include_directories(karyo-greetd PUBLIC ${PROJECT_SOURCE_DIR}/greeter)
target_link_libraries(karyo-greetd PUBLIC Qt6::Network)
if(BUILD_TESTING)
    add_executable(karyo-greetd-test tests/greetdtest.cpp)
    target_link_libraries(karyo-greetd-test PRIVATE karyo-greetd Qt6::Test)
    add_test(NAME greeter-ipc COMMAND karyo-greetd-test)
    set_tests_properties(greeter-ipc PROPERTIES TIMEOUT 30)
endif()

add_library(karyo-greeter-auth STATIC greeter/authentication.cpp greeter/authentication.h)
target_link_libraries(karyo-greeter-auth PUBLIC karyo-greetd)
if(BUILD_TESTING)
    add_executable(karyo-greeter-auth-test tests/greetdauthtest.cpp)
    target_link_libraries(karyo-greeter-auth-test PRIVATE karyo-greeter-auth Qt6::Test)
    add_test(NAME greeter-authentication COMMAND karyo-greeter-auth-test)
    set_tests_properties(greeter-authentication PROPERTIES TIMEOUT 30)
endif()

include(${PROJECT_SOURCE_DIR}/cmake/DesktopAccounts.cmake)
add_library(karyo-greeter-inventory STATIC greeter/inventory.cpp greeter/inventory.h)
target_include_directories(karyo-greeter-inventory PUBLIC ${PROJECT_SOURCE_DIR}/greeter)
target_link_libraries(karyo-greeter-inventory PUBLIC karyo-desktop-accounts karyo-signin-view Karyo::DesktopIntegration)

if(BUILD_TESTING)
    add_executable(karyo-greeter-inventory-test tests/greeterinventorytest.cpp)
    target_link_libraries(karyo-greeter-inventory-test PRIVATE karyo-greeter-inventory Qt6::Test)
    add_test(NAME greeter-users-sessions-preferences COMMAND karyo-greeter-inventory-test)
    set_tests_properties(greeter-users-sessions-preferences PROPERTIES TIMEOUT 30)
endif()

add_library(karyo-greeter-appearance STATIC greeter/appearance.cpp greeter/appearance.h)
target_include_directories(karyo-greeter-appearance PUBLIC ${PROJECT_SOURCE_DIR}/greeter)
target_link_libraries(karyo-greeter-appearance PUBLIC Qt6::Core)
if(BUILD_TESTING)
    add_executable(karyo-greeter-appearance-test tests/greeterappearancetest.cpp)
    target_link_libraries(karyo-greeter-appearance-test PRIVATE karyo-greeter-appearance Qt6::Test)
    add_test(NAME greeter-published-appearance COMMAND karyo-greeter-appearance-test)
    set_tests_properties(greeter-published-appearance PROPERTIES TIMEOUT 30)
endif()

add_library(karyo-greeter-window STATIC greeter/greeterwindow.cpp greeter/greeterwindow.h)
target_link_libraries(karyo-greeter-window PUBLIC karyo-greeter-auth karyo-greeter-inventory karyo-greeter-appearance Karyo::Style)
if(BUILD_TESTING)
    add_executable(karyo-greeter-window-test tests/greeterwindowtest.cpp)
    target_link_libraries(karyo-greeter-window-test PRIVATE karyo-greeter-window Qt6::Test)
    add_test(NAME greeter-window-workflows COMMAND karyo-greeter-window-test)
    set_tests_properties(greeter-window-workflows PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 30)
endif()

include(${PROJECT_SOURCE_DIR}/cmake/Translations.cmake)
qt_add_executable(karyo-greeter greeter/main.cpp)
target_link_libraries(karyo-greeter PRIVATE karyo-greeter-window)
karyo_add_translation(karyo-greeter "${PROJECT_SOURCE_DIR}/greeter/translations/karyo-greeter_ru.ts")
install(TARGETS karyo-greeter RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} COMPONENT greeter-runtime)
install(FILES greeter/data/karyo-greeter.desktop
    DESTINATION ${CMAKE_INSTALL_DATADIR}/applications COMPONENT greeter-runtime)
install(FILES LICENSE docs/PROVENANCE.md docs/GREETER.md greeter/data/greetd-karyo.toml.example
    DESTINATION ${CMAKE_INSTALL_DATADIR}/doc/karyo-greeter COMPONENT greeter-runtime)
if(BUILD_TESTING)
    add_test(NAME greeter-command-help COMMAND karyo-greeter --help)
    set_tests_properties(greeter-command-help PROPERTIES TIMEOUT 10 PASS_REGULAR_EXPRESSION "Usage: karyo-greeter")
endif()
