# Shared presentation only: authentication stays with lock PAM or greetd.
option(KARYO_BUILD_SESSION "Build Wayland shell and lock components" ON)
option(KARYO_BUILD_GREETER "Build the optional greetd integration" ${KARYO_BUILD_SESSION})
if(NOT KARYO_BUILD_SESSION AND NOT KARYO_BUILD_GREETER)
    return()
endif()
if(NOT TARGET Karyo::Widgets)
    message(FATAL_ERROR "Karyo sign-in components require desktop integration/widgets")
endif()
add_library(karyo-signin-view STATIC lock/signin.cpp lock/signin.h
    lock/signinview.cpp lock/signinview.h)
target_include_directories(karyo-signin-view PUBLIC ${PROJECT_SOURCE_DIR}/lock)
target_link_libraries(karyo-signin-view PUBLIC Karyo::Widgets)
if(BUILD_TESTING)
    add_executable(karyo-signin-view-test tests/signinviewtest.cpp)
    target_link_libraries(karyo-signin-view-test PRIVATE karyo-signin-view Qt6::Test)
    add_test(NAME lock-error-layout COMMAND karyo-signin-view-test)
    set_tests_properties(lock-error-layout PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
endif()
