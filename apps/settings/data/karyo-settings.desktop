[Desktop Entry]
Type=Application
Name=Settings
Name[ru]=Параметры
GenericName=System settings
GenericName[ru]=Настройки системы
Comment=Personalize the desktop and set up the system, network, apps and accounts
Comment[ru]=Оформление рабочего стола, система, сеть, приложения и учётные записи
Exec=karyo-settings
Icon=preferences-system
Terminal=false
Categories=Settings;System;
Keywords=settings;preferences;theme;wallpaper;display;network;language;keyboard;
Keywords[ru]=параметры;настройки;тема;обои;экран;сеть;язык;клавиатура;
StartupWMClass=karyo-settings
